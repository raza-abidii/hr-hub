                <button class="btn btn-sm btn-primary" id="btnRefreshDept">
                    @* <i class="bi bi-arrow-clockwise"></i> *@
                    <svg id="refreshIconDept" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 1 0-.908-.418A6 6 0 1 0 8 2v1z" />
                        <path d="M8 0a.5.5 0 0 0-.5.5v3.707L6.354 3.061a.5.5 0 1 0-.708.708l2 2a.5.5 0 0 0 .708 0l2-2a.5.5 0 0 0-.708-.708L8.5 4.207V.5A.5.5 0 0 0 8 0z" />
                    </svg>
                </button>
            </div>
            <div class="card-body py-2 px-3" id="cardBodyDept" style="font-size: 0.9rem;">
                <div style="width:296px;margin-left:-15px;margin-top:-5px; overflow-y: auto;max-height:248px" id="scrollContainer">
                    @if (ViewBag.Department != null)
                    {
                        <ul id="deptCard" class="list-group">
                            @foreach (var item in ViewBag.Department)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@item.sName</strong><br />
                                        <small>@item.sName-@item.sCode</small>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
