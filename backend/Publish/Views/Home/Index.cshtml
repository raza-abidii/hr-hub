                    }
                </div>
            </div>
        </div>
    }
    @if (role == "Admin")
    {
        <!-- Shift Card -->
        <div class="card shadow-sm rounded" style="width: 300px;height:300px;top:-15px ;background-color:#575357" id="shiftCard">
