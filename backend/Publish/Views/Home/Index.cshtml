<script>
    let selectedAction = '';
    let selectedLeaveId = 0;

    $('body').on('click', '.btnApprove, .btnReject', function () {
        debugger;
        selectedLeaveId = $(this).data('id');
        selectedAction = $(this).hasClass('btnApprove') ? 'Approve' : 'Reject';

        $('#modalLeaveId').val(selectedLeaveId);
        $('#modalActionType').val(selectedAction);
        $('#modalRemarks').val('');
        $('#remarksModal').modal('show');
    });

    $('#submitRemarks').click(function () {
        var id = $('#modalLeaveId').val();
        var action = $('#modalActionType').val();
        var remarks = $('#modalRemarks').val();

        if (!remarks.trim()) {
            alert("Remarks are required.");
            return;
        }

        $.post(`@Url.Action("HandleLeaveAction", "LeaveApprovalManual")`, {
            id: id,
            actionType: action,
            remarks: remarks
        }, function (res) {
            if (res.success) {
                alert(`Leave ${action}d successfully.`);
                $('#remarksModal').modal('hide');
                @* $('#btnDisplay').click(); // Reload table *@
                // Optionally, you can refresh the leave alert table here
                location.reload(); // Reload the page to reflect changes

            } else {
                alert(res.message);
            }
        });
    });
</script>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        const cells = document.querySelectorAll(".calendar-cell");

        // Initialize tooltip on all cells
        cells.forEach(cell => {
            const tooltip = new bootstrap.Tooltip(cell, {
                trigger: 'manual', // We will handle showing manually
                placement:'auto',
                html: true
            });

            cell.addEventListener("click", function (e) {
                // Hide all other tooltips
                document.querySelectorAll('.calendar-cell').forEach(el => {
                    bootstrap.Tooltip.getInstance(el)?.hide();
                });
            debugger

            var rem= cell.querySelector("span:not([hidden])").textContent
            if (rem !== 'Absent' && rem !== 'Public Holiday' && rem !== 'Leave')
            {
                // Show clicked one
                tooltip.show();
            }

            // Hide again after 3 seconds
            setTimeout(() => tooltip.hide(), 3000);
            });
        });
    });
</script>