@using Microsoft.AspNetCore.Http
@using System.Globalization
@{
    ViewData["Title"] = "Home Page";
    var role = Context.Session.GetString("Role");
}

@model List<EMSSolution.Models.TimecardAdvance>
@{
    int year = ViewBag.Year;
    int month = ViewBag.Month;
    var daysInMonth = DateTime.DaysInMonth(year, month);
    var firstDayOfWeek = (int)new DateTime(year, month, 1).DayOfWeek;
    var date = new DateTime(year, month, 1);
    var currentYear = DateTime.Now.Year;
    var years = Enumerable.Range(currentYear - 5, 11).ToList();
    var prevDate = new DateTime(year, month, 1).AddMonths(-1);
    var nextDate = new DateTime(year, month, 1).AddMonths(1);
}

<style>
    .table-sm th, .table-sm td {
        padding: 0.2rem;
    }

    .card {
        font-size: 12px;
        border-radius: 10px;
    }

    .card-header h5 {
        font-size: 14px;
    }

    .calendar-cell {
        cursor: pointer;
        font-size: 11px;
        padding: 2px;
    }

    .bg-present {
        background-color: #c8e6c9 !important;
    }

    .bg-leave {
        background-color: #fff9c4 !important;
    }

    .bg-absent {
        background-color: #ffcdd2 !important;
    }

    .bg-late {
        background-color: #ffab91 !important;
    }

    .bg-holiday {
        background-color: #b2dfdb !important;
    }

    .calendar-wrapper {
        max-width: 300px;
        width: 100%;
        margin: auto;
    }

    .nav-controls {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
    }

    select.form-select-sm, .btn-sm {
        font-size: 12px;
        padding: 0.2rem 0.4rem;
    }
</style>

@* Toast Message to show the error for Password Change *@
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
        //debugger;
        // Show toast if message exists
        var toastEl = document.getElementById('toastMessage');
        if (toastEl && toastEl.innerText.trim() !== "") {
        var toast = new bootstrap.Toast(toastEl);
        toast.show();

        }

        // Show Change Password Modal if flag is set
        var shouldShowModal = '@TempData["ShowChangePasswordModal"]';
        if (shouldShowModal === 'true') {
        var modal = new bootstrap.Modal(document.getElementById('changePasswordModal'));
        modal.show();
        }
        });
    </script>
}

<div class="home-background">
    @* <h1>Welcome to My MVC App</h1>
    <p>This is the home page with a background image.</p> *@
</div>

<div class="container mt-4 d-flex gap-4 flex-wrap">
    @if (role == "Admin")
