@{
    var months = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.MonthNames;
}
@{
    // ViewBag.Employees is assumed to be a List of objects with "Name" and "Code"
    var employeesJson = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Employees);
}
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Shift Allocation</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <style>
        #tooltip {
            position: absolute;
            background: #333;
            color: #fff;
            padding: 5px 10px;
            border-radius: 4px;
            font-size: 12px;
            display: none;
            pointer-events: none;
            z-index: 1000;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f6f9;
            margin: 40px;
        }

        .attendance-container {
            overflow-x: auto;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            background: #fff;
            padding: 1rem;
        }

        table.attendance-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 800px;
        }

        .attendance-table thead {
            background-color: #1e88e5;
            color: white;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .attendance-table th, .attendance-table td {
            padding: 10px 14px;
            text-align: center;
            border-bottom: 1px solid #e0e0e0;
            white-space: nowrap;
        }

        .attendance-table tbody tr:nth-child(odd) {
            background-color: #f9f9f9;
        }

        .attendance-table tbody tr:hover {
            background-color: #f1f7ff;
        }

        .employee-name {
            text-align: left;
            font-weight: 600;
            color: #333;
        }

        .select2-container {
            width: 100% !important;
        }

        .select-dropdown {
            width: 100%;
        }
    </style>


</head>
<body class="bg-gray-100 p-6">

    <div class="container">

        <div style="margin-top:-74px;margin-left:10px">
            <div class="bg-white p-6 rounded-2xl shadow-md mb-6">
                <h1 class="text-2xl font-bold mb-4 text-center">

                    Employee Attendance Report
                </h1>

                <div class="grid grid-cols-4 md:grid-cols-4 gap-4 mb-4">
                    <div class="form-group-2 col-span-1">
                        <label class="bold-label">Report Type:</label><br />
                        <label><input type="radio" name="ReportType" value="EmployeeWise" checked onchange="toggleAllocationView()" /> Employee-wise</label>
                        <label><input type="radio" name="ReportType" value="CategoryWise" onchange="toggleAllocationView()" /> Category-wise</label>
                    </div>
                    <div id="employeeDropdown" class="form-group w-full min-w-0">
                        <label class="bold-label">Employee</label>
                        <select id="employee" name="employee" class="select-dropdown">
                            <option>Select Employee</option>
                            @foreach (var employee in ViewBag.Employees)
                            {
                                <option value="@employee.iMasterid">@employee.sEmployeeName</option>
                            }
                        </select>
                    </div>
                    <div id="categoryDropdown" class="form-group w-full min-w-0" style="display: none; ">
                        <label class="bold-label">Category</label>
                        <select id="category" name="category" class="select-dropdown">
                            <option>Select Category</option>
                            @foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.iMasterid">@category.sName</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Month</label>
                        <select id="monthSelect" class="select-dropdown">
                            @for (int i = 1; i <= 12; i++)
                            {
                                var selectedmonthName = (i == @ViewBag.selectedMonth ? "selected" : "");
                                if (selectedmonthName == "")
                                {
                                    <option value="@i">@months[i - 1]</option>
                                }
                                else
                                {
                                    <option value="@i" selected>@months[i - 1]</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Year</label>
                        <select id="yearSelect" class="select-dropdown">
                            @for (int y = DateTime.Now.Year - 5; y <= DateTime.Now.Year + 5; y++)
                            {
                                var yearName = (y == ViewBag.SelectedYear ? "selected" : "");
                                if (yearName == "")
                                {
                                    <option value="@y">@y</option>
                                }
                                else
                                {
                                    <option value="@y" selected>@y</option>
                                }

                            }
                        </select>
                    </div>
                </div>

                <div class="flex space-x-4">
                    <button id="display" class="bg-blue-600 text-white px-4 py-2 rounded-xl hover:bg-blue-700">Display</button>
                    <button id="exportexcel" class="bg-green-600 text-white px-4 py-2 rounded-xl hover:bg-green-700">Export to Excel</button>
                </div>
            </div>

            <div class="attendance-container overflow-x-auto p-4 bg-white shadow rounded-lg">
                <table id="myTable" class="attendance-table min-w-full text-sm text-left text-gray-700 border border-gray-200">
                    <thead class="bg-gray-100 text-xs uppercase text-gray-600" id="tableHeader">
                        <tr>
                            <th class="px-2 py-1 border-r border-gray-200">Employee Name</th>
                            <th class="px-2 py-1 border-r border-gray-200">Category Name</th>
                            <!-- Add dynamic date headers here -->
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        <tr>
                            <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">XXX</td>
                            <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">ZZZ</td>
                            <!-- Add sample date data here -->
                        </tr>
                        <!-- Repeat rows as needed -->
                    </tbody>
                </table>
            </div>

        </div>


        <br />
        <div id="legend" style="display: flex; flex-wrap: wrap; gap: 1rem; padding: 1rem; border: 1px solid #ccc; border-radius: 8px;">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <div style="width: 20px; height: 20px; background-color: #d1ecf1;"></div>
                <span>Public Holiday</span>
            </div>

            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <div style="width: 20px; height: 20px; background-color: #F19E9E;"></div>
                <span>Late In</span>
            </div>

            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <div style="width: 20px; height: 20px; background-color: #9D5050;"></div>
                <span>Early Out</span>
            </div>

            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <div style="width: 20px; height: 20px; background-color: #E58110;"></div>
                <span>Late In/Early Out</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <div style="width: 20px; height: 20px; background-color: #f8d7da;"></div>
                <span>Absent</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <div style="width: 20px; height: 20px; background-color: #155724;"></div>
                <span>Ontime</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <div style="width: 20px; height: 20px; background-color: #28a745;"></div>
                <span>Leave</span>
            </div>
            
        </div>

        <div id="tooltip"></div>

        <br />
    </div>
</body>

</html>

<script src="/js/GenericFunction.js"></script>
<script>

     $(document).ready(function() {
        $('#employee').select2({
            placeholder: "Select employee",
            allowClear: true
        });
        $('#category').select2({
            placeholder: "Select category",
            allowClear: true
        });
        $('#monthSelect').select2({
            placeholder: "Select Month",
            allowClear: true
        });
        $('#yearSelect').select2({
            placeholder: "Select Year",
            allowClear: true
        });

        focusonselectcontrol("#employee");
        focusonselectcontrol("#category");
        focusonselectcontrol("#monthSelect");
        focusonselectcontrol("#yearSelect");

     });

     // Event listener for the display button
     //ajax call attendanceReport/GetAttendanceReportData
        $("#display").click(function () {
            debugger;
            generateTableHeader();
            var employee = $("#employee").val();
            var employeename=$("#employee").find('option:selected').text()
            var category = $("#category").val();
            var categoryname=$("#category").find('option:selected').text()
            var month = $("#monthSelect").val();
            var year = $("#yearSelect").val();
            var reportType = $("input[name='ReportType']:checked").val();
            if(reportType=="EmployeeWise")
            {
                if (employeename=='Select Employee' || !month || !year) {
                    alert("Please select employee, Month,Year ");
                    return;
                }
            }
            else
            {
                if (categoryname=='Select Category' || !month || !year) {
                    alert("Please select category, Month,Year ");
                    return;
                }
            }


            debugger;
            $.ajax({
                url: '@Url.Action("GetAttendanceReportData", "AttendanceReport")',
                type: 'post',
                data: {
                    iEmployee: employee,
                    iCategory: category,
                    iMonth: month,
                    iYear: year,
                    EmployeeName:employeename,
                    CategoryName:categoryname,
                    ReportType: reportType
                },
                success: function (response) {
                    debugger;
                    if(response.success==true)
                        displayData(response.data)
                    else
                        alert (response.message);
                    // Populate the table with the returned data


                    // You can use a loop to create rows dynamically
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching data:", error);
                }
            });
        });

        //exporttoexcel
        $("#exportexcel").click(function () {
            debugger;

            var month = $("#monthSelect").find('option:selected').text();
            var year = $("#yearSelect").find('option:selected').text();


            debugger;
            var tabledata= getTableData();
            $.ajax({
                url: '@Url.Action("ExportToExcel", "AttendanceReport")',
                type: 'GET',
                data: {
                    attendanceData: tabledata,
                    month:month,
                    year:year
                },
                xhrFields: {
                    responseType: 'blob' // This tells jQuery to treat the response as binary
                },
                success: function (data, status, xhr) {
                    debugger;
                    // Try to get filename from content-disposition
                    var disposition = xhr.getResponseHeader('Content-Disposition');
                    var matches = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/.exec(disposition);
                    var filename = (matches != null && matches[1]) ? matches[1].replace(/['"]/g, '') : "AttendanceReport.xlsx";

                    // Create a link and download
                    var blob = new Blob([data], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                    var url = window.URL.createObjectURL(blob);

                    var a = document.createElement('a');
                    a.href = url;
                    a.download = filename;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    window.URL.revokeObjectURL(url);
                },
                error: function (xhr, status, error) {
                    console.log("Error fetching data:", error);
                }
            });
        });

        function getTableData() {
            const table = document.getElementById("myTable");
            const data = [];
            debugger;
            for (let i = 1; i < table.rows.length; i++) {
                const row = table.rows[i];
                const rowData = {};
                for (let j = 0; j < row.cells.length; j++) {
                    const cell = row.cells[j];
                    if (j === 0) {
                        rowData.EmployeeName = cell.textContent;
                    } else if (j === 1) {
                        rowData.CategoryName = cell.textContent;
                    } else {
                        rowData[`day-${j - 2}`] = cell.textContent;
                        rowData[`day-${j - 2}bg`] = cell.style.backgroundColor;
                    }
                }
                data.push(rowData);
            }
            return data;
        }



        function displayData(data)
        {
            debugger;
            const month = document.getElementById("monthSelect").value;
            const year = document.getElementById("yearSelect").value;
            const daysInMonth = new Date(year, month, 0).getDate();

            const tbody = document.querySelector("#myTable tbody");
            $('#myTable tbody').empty();
            data.forEach(item => {
                const row = document.createElement("tr");
                row.innerHTML = `
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">${item.EmployeeName}</td>
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">${item.CategoryName}</td>

                `;
                // Add dynamic date cells
                for (let i = 1; i <= daysInMonth; i++) {
                    const cell = document.createElement("td");
                    cell.className = "px-2 py-1 whitespace-nowrap border-r border-gray-100";
                    cell.textContent =item[`day-${i-1}-in`] + '-' + item[`day-${i-1}-out`]; // Adjust according to your data structure
                    //change cell color
                    if(item[`day-${i-1}-ph`]=="Sunday")
                        cell.style.backgroundColor = "#d1ecf1";
                    else if(item[`remarks-${i-1}`]=="Late In/Early Out")
                        cell.style.backgroundColor = "#E58110";
                    else if(item[`remarks-${i-1}`]=="Late In")
                        cell.style.backgroundColor = "#F19E9E";
                    else if(item[`remarks-${i-1}`]=="Early Out")
                        cell.style.backgroundColor = "#9D5050";
                    else if(item[`remarks-${i-1}`]=="")
                    {
                        if(cell.textContent=='-')
                        {
                            cell.style.backgroundColor = "#f8d7da";//Absent
                            cell.style.color = "#721c24";
                            cell.textContent='Absent';
                        }
                        else
                            cell.style.backgroundColor = "#155724";//ontime

                    }

                    if (item[`remarks-${i-1}`]?.includes("Leave")) {
                        // Leave Type Not Specified then;//
                        cell.style.backgroundColor = "#28a745";//Earned Leave
                        cell.textContent='Leave';
                    }
                    if(item[`remarks-${i-1}`]=="LeaveCL")
                    {
                       //casual Leave
                        cell.textContent='Leave-CL';
                    }
                    if(item[`remarks-${i-1}`]=="LeaveEL")
                    {
                        //Earned Leave
                        cell.textContent='Leave-EL';
                    }
                    
                  
                    cell.style.color = "white";
                    row.appendChild(cell);
                }
                tbody.appendChild(row);
            });


        }

    //generate dynamic table based on month year selection
    function generateTableHeader() {
        debugger;
        const month = document.getElementById("monthSelect").value;
        const year = document.getElementById("yearSelect").value;
        if (!month || !year) return;

        const daysInMonth = new Date(year, month, 0).getDate();
        const headerRow = document.getElementById("tableHeader").rows[0];

        // Clear existing day columns
        while (headerRow.cells.length > 3) {
            headerRow.deleteCell(-1);
        }

        for (let day = 1; day <= daysInMonth; day++) {
            const th = document.createElement("th");
            th.textContent = `${String(day).padStart(2, '0')}-${String(month).padStart(2, '0')}`;
            headerRow.appendChild(th);
        }
    }

    $('#myTable').on('click', 'td', function(e) {
        debugger;
      const bgColor = $(this).css('background-color');
      var tooltipText = "";
      if (bgColor === 'rgb(209, 236, 241)') { // red background
        tooltipText = "Sunday";
      }
      else  if (bgColor === 'rgb(241, 158, 158)') { // red background
        tooltipText = "Late In";
      }
      else  if (bgColor === 'rgb(229, 129, 16)') { // red background
        tooltipText = "Late In/Early Out";
      }
      else  if (bgColor === 'rgb(157, 80, 80)') { // red background
        tooltipText = "Early Out";
      }
      else  if (bgColor === 'rgb(234, 5, 5)') { // red background
        tooltipText = "Absent";
      }
      else  if (bgColor === 'rgb(21, 87, 36)') { // red background
        tooltipText = "OnTime";
      }

      else {
        $('#tooltip').hide();
      }

      if (tooltipText) {
          $('#tooltip')
            .text(tooltipText)
            .css({
              top:  e.pageY + 10 + 'px',
              left: e.pageX + 10 + 'px'
            })
            .show();
        }

    });

    $('#myTable').on('mouseleave', 'td', function () {
      $('#tooltip').hide();
    });

    function toggleAllocationView() {
        const isEmployeeWise = document.querySelector('input[name="ReportType"]:checked').value === "EmployeeWise";
        document.getElementById("employeeDropdown").style.display = isEmployeeWise ? "block" : "none";
        document.getElementById("categoryDropdown").style.display = isEmployeeWise ? "none" : "block";
    }




</script>
<script>
    // Parse the Razor-passed employees into JavaScript
    const employees = @Html.Raw(employeesJson);
    const select = document.getElementById("employee");

    let showCodeOnly = false;

    function renderOptions() {
        const selectedValue = select.value;
        select.innerHTML = "";

        employees.forEach(emp => {
            const option = document.createElement("option");
            option.value = emp.iMasterid;
            option.text = showCodeOnly ? emp.sEmployeeCode : emp.sEmployeeName;
            select.appendChild(option);
        });

        select.value = selectedValue;
    }

    renderOptions();

    document.addEventListener("keydown", function (e) {
        // if (e.altKey && e.key === "F2") {
        if (e.key === "F2") {
            showCodeOnly = !showCodeOnly;
            renderOptions();
        }
    });
</script>