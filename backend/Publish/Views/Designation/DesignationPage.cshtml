@model List<EMSSolution.Models.Designation>


<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    @* <link rel="stylesheet" type="text/css" href="~/Content/bootstrap.css" />
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css" rel="stylesheet" /> *@
    @*<meta name="viewport" content="width=device-width" />
        <title>View</title>*@
    <link rel="stylesheet" href="~/css/Style.css">
    <style>
        .flex {
            display: flex;
            gap: 16px;
        }

        body {
            background-color: #cccccc;
        }

        input:invalid {
            border: 2px solid red;
        }
    </style>
</head>

<body>

    <div class="container">
        <h2 class="text-center">Designation
            <svg width="30" height="30" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                <rect width="512" height="512" fill="#f0f0f0" />
                <rect x="16" y="16" width="480" height="480" rx="30" fill="#e0e0e0" stroke="#333" stroke-width="12" />
                <rect x="32" y="32" width="448" height="60" rx="10" fill="#3b83f6" />
                <circle cx="104" cy="180" r="50" fill="#ffc107" stroke="#333" stroke-width="8" />
                <circle cx="104" cy="180" r="20" fill="#fff" />
                <line x1="150" y1="180" x2="240" y2="180" stroke="#333" stroke-width="12" />

                <!-- Vertical boxes (right) -->
                <rect x="240" y="150" width="80" height="40" rx="8" fill="#ffc107" stroke="#333" stroke-width="8" />
                <rect x="240" y="210" width="80" height="40" rx="8" fill="#ffc107" stroke="#333" stroke-width="8" />
                <rect x="240" y="270" width="80" height="40" rx="8" fill="#ffc107" stroke="#333" stroke-width="8" />

                <!-- Horizontal boxes (bottom left) -->
                <rect x="100" y="320" width="80" height="40" rx="8" fill="#ffc107" stroke="#333" stroke-width="8" />
                <line x1="180" y1="340" x2="240" y2="340" stroke="#333" stroke-width="12" />
                <rect x="240" y="320" width="80" height="40" rx="8" fill="#ffc107" stroke="#333" stroke-width="8" />
            </svg>

        </h2>
        <div asp-validation-summary="All" class="text-bg-danger"></div>
        <div class="form-group mb-3">

            <label for="lName" class="form-label">Name <span style="color: red;">*</span></label>
            <input type="text" name="name" id="name" class="form-control" required
                   placeholder="Enter Name [Mandatory]" />
            @* <span asp-validation-for="sName" class="text-bg-danger"></span> *@
        </div>
        <div class="form-group mb-3">

            <label for="lCode" class="form-label">Code <span style="color: red;">*</span></label>
            <input type="text" name="code" id="code" class="form-control" required
                   placeholder="Enter Code [Mandatory]" />
            @* <span asp-validation-for="code" class="text-bg-danger"></span> *@
        </div>
        <div class="form-group mb-3">
            <label for="machineid" class="form-label">Description</label>
            <input type="text" name="description" id="description" class="form-control" placeholder="Enter Description" />
        </div>

        <div class="flex">
            <button id="btnsummit" type="submit" class="btn btn-outline-primary"
                    style="width:120px" accesskey="s">
                Save
            </button>
            <button id="btnrefresh" type="submit" class="btn btn-outline-primary" style="width:120px" accesskey="r">Refresh</button>
            <button id="btnDelete" type="submit" class="btn btn-outline-primary" style="width:120px" accesskey="d">Delete</button>
        </div>

    </div>

     <div style="display: flex; justify-content: flex-end; margin-bottom: 10px;">
        <input type="text" id="searchBox" class="col-4 display: flex margin-right" placeholder="Search..." onkeyup="searchTable()" />
    </div>

    <div class="table-responsive">
        <table id="myTable" class="table table-striped table-hover">
            <thead>
                <tr>
                    <th> Sno</th>
                    <th> Name</th>
                    <th> Code</th>
                    <th> Description</th>
                    <th hidden> Masterid</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var intRow = 1;

                    foreach (var entry in Model)
                    {

                        <tr>
                            <td>@intRow</td>
                            <td>@entry.sName</td>
                            <td>@entry.sCode</td>
                            <td>@entry.sDescription</td>
                            <td hidden>@entry.iMasterid</td>
                        </tr>
                        intRow = intRow + 1;
                    }
                }
            </tbody>
        </table>
    </div>

</body>
</html>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/js/GenericFunction.js"></script>
<script>

    $(document).ready(function () {
        debugger;
        var iRowNo = 0;
        var currentRow;
        var masterid=0;
        clearControl();

    });

    $('#btnrefresh').click(function (e) {
        debugger;
        clearControl();
    });

    $('#btnsummit').click(function (e) {
        debugger;
        let name =document.getElementById('name');
        name.value=name.value.trim();
        let code=document.getElementById('code');
        code.value=code.value.trim();
        name.setCustomValidity('');
        code.setCustomValidity('');
        if (!name.checkValidity()) {
            name.setCustomValidity('Please enter a valid name');
            name.reportValidity();
            return;
        }
        if (!code.checkValidity()) {
            code.setCustomValidity('Please enter a valid code');
            code.reportValidity();
            return;
        }

        $('#loader').show();
        // if ($('#name').val() == '') {
        //     alert('Provide Name');
        //     $('#loader').hide();
        //     $("#name").focus();
        //     return;
        // }
        // if ($('#code').val() == '') {
        //     alert('Provide Code');
        //     $('#loader').hide();
        //     $("#code").focus();
        //     return;
        // }


        var Name = $('#name').val();
        var Code = $('#code').val();
        var Description = $('#description').val();
        var Masterid = masterid;
        debugger;
        var requestdata=JSON.stringify({iMasterid: Masterid, sName: Name, sCode: Code, sDescription: Description});
    //baseurl = 'http://localhost/BiometricApplication'
        $.ajax
            ({

            url: '@Url.Action("SaveDesignation", "Designation")',
            datatype: 'JSON',
            type: "post",
            contentType: "application/json; charset=utf-8",
            cashe: true,
            data: requestdata,
            success: function (response) {
                debugger;

                if (response.status == true) {
                    updateTable(response.data, response.isNew)
                    clearCotrol();
                    alert(response.message);
                    $('#loader').hide();
                }
                else {
                    $('#loader').hide();
                    alert(response.message);
                }
            },
            error: function (e) {
                $('#loader').hide();
                debugger;
            }
        })
    });

    $('#btnDelete').click(function (e) {
        debugger;
        $('#loader').show();
        if (masterid == 0) {
            alert('Select a row to delete');
            $('#loader').hide();
            return;
        }
        if (confirm("Are you sure you want to delete this record?")) {
            $.ajax
                ({
                    url: '@Url.Action("DeleteDesignation", "Designation")',
                    datatype: 'JSON',
                    type: "post",
                    cashe: true,
                    data: { iMasterId: masterid },
                    success: function (response) {
                        debugger;
                        if (response.status == true) {
                            alert(response.message);
                            $('#loader').hide();
                            clearControl();
                            location.reload(true);
                        }
                        else {
                            $('#loader').hide();
                            alert(response.message);
                        }
                    },
                    error: function (e) {
                        $('#loader').hide();
                        debugger;
                    }
                })
        }
    });


    $('body').on('click', 'tr', function () {
        debugger;
        var name = $(this).find("td").eq(1).html();
        var code= $(this).find("td").eq(2).html();
        var description = $(this).find("td").eq(3).html();
        masterid = $(this).find("td").eq(4).html();

        $('#name').val(name);
        $('#code').val(code);
        $('#description').val(description);

        iRowNo = $(this).closest("tr")[0].rowIndex;
        currentRow = $(this).closest("tr");

    });
    function clearControl() {
        $('#name').val('');
        $('#code').val('');
        $('#description').val('');
        $("#name").focus();
        masterid = 0;
    }
    function updateTable(res, isNew) {
        debugger;
        if (isNew == 1) {

            var rowCount = $('#myTable tr').length;
            for (let i = 0; i < res.length; i++) {

                $('#myTable').append('<tr>' +
                    '<td>' + (rowCount) + '</td>' +
                    '<td >' + res[i].sName + '</td > ' +
                    '<td >' + res[i].sCode + '</td > ' +
                    '<td >' + res[i].sDescription + '</td > ' +
                    '<td style="display:none;">' + res[i].iMasterid + '</td > ' +
                    '</tr>');
            }
        }
        else {

            $("#myTable").val(currentRow.find("td:eq(1)").text(res[0].sName));
            $("#myTable").val(currentRow.find("td:eq(2)").text(res[0].sCode));
            $("#myTable").val(currentRow.find("td:eq(3)").text(res[0].sDescription));
            $("#myTable").val(currentRow.find("td:eq(4)").text(res[0].iMasterid));

        }
    }

    function clearCotrol() {
        $('#name').val('');
        $('#code').val('');
        $('#description').val('');
        masterid=0;
        $("#name").focus();
    }
</script>