    <style>
        body {
            font-family: "Lato", sans-serif;
            background-color: #cccccc;
        }

        .sidenav {
            height: 100%;
            width: 0;
            position: fixed;
            z-index: 1;
            top: 0;
            left: 0;
            background-color: #849bb0;
            overflow-x: hidden;
            transition: 0.5s;
            padding-top: 60px;
        }

        .sidenav a {
            padding: 8px 8px 8px 32px;
            text-decoration: none;
            font-size: 15px;
            color: white;
            display: block;
            transition: 0.3s;
        }

        .sidenav a:hover {
            color: #f1f1f1;
        }

        .sidenav .closebtn {
            position: absolute;
            top: 0;
            right: 25px;
            font-size: 20px;
            margin-left: 50px;
        }

        .main-content {
            transition: margin-left 0.5s;
            margin-left: 0;
        }

        .sidenav-open .main-content {
            margin-left: 250px; /* same as sidenav width */
        }

        .sidenav-group-title {
            font-weight: bold;
            padding-left: 32px;
            padding-top: 10px;
            padding-bottom: 5px;
            font-size: 14px;
            color: #1F2937; /* Dark text */
            background-color: #d9e3f0; /* Slight background contrast */
        }

        .sidenav-group a {
            padding-left: 48px; /* Indented links inside group */
        }

        .tree-nav {
            font-family: Arial, sans-serif;
        }

        .tree-toggle {
            display: flex;
            align-items: center;
            gap: 8px;
            background: none;
            border: none;
            font-size: 16px;
            cursor: pointer;
            color:white;
        }

        .arrow {
            transition: transform 0.2s ease;
        }

            .arrow.open {
                transform: rotate(90deg);
            }

        .tree-children {
            margin-left: 28px;
            display: none;
        }

        .tree-children.open {
            display: block;
        }

        .tree-children a {
            display: block;
            margin: 4px 0;
            text-decoration: none;
            color: white;
        }

        .sidenav ul {
            list-style: none;
            padding-left: 1rem;
        }

        .sidenav li {
            margin: 4px 0;
        }

        
    </style>

</head>

