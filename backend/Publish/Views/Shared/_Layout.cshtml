@using Microsoft.AspNetCore.Http

@{
    var role = Context.Session.GetString("Role");
    var menurights = string.IsNullOrEmpty(Context.Session.GetString("UserRights")) ? null : Context.Session.GetString("UserRights").Split(',').ToList();

}
@{
    //var theme = Context.Session.GetString("AppTheme") ?? "theme-light";
    var theme = Context.Request.Cookies["AppTheme"] ?? "light";
}
@{
    var isDev = Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development";
    var csspath = isDev ? "" : "/EMSSolution";
}

@if (Context.Session.GetString("HideSideNav") == "false")
{
    @* User Profile Setting *@
    <div class="dropdown gmail-style-dropdown ms-auto me-3" style="position: absolute; top:4px; right: -31px;">
        @* <a class="btn dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown"  *@
        <a class="btn  d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown"
           aria-expanded="false">
            <img src="data:image/png;base64,@Context.Session.GetString("sImage")"
                 class="me-2" alt="User" width="60" height="37" style="margin-top:-10px" />
        </a>
        <ul class="dropdown-menu dropdown-menu-end p-3" style="min-width: 300px;">
            <li class="text-center">
                <img src="data:image/png;base64,@Context.Session.GetString("sImage")" alt="Profile Picture" class="profile-img mb-2" style="width: 80px; height: 80px; border-radius: 50%;" />
                <div class="fw-bold">@Context.Session.GetString("UserName")</div>
                <div class="text-muted small">@Context.Session.GetString("Role")</div>
            </li>
            <li class="text-center mt-2">
                <form asp-action="UpdateProfilePicture" method="post" enctype="multipart/form-data" id="profileForm">
                    <input type="file" name="profileImage" id="profileImage" class="d-none" accept="image/*" onchange="document.getElementById('profileForm').submit();" />
                    <label for="profileImage" class="btn btn-sm btn-outline-primary">Edit Profile Picture</label>
                </form>
            </li>
            <li><hr class="dropdown-divider" /></li>

            <!-- 🔐 Change Password Form -->
            <li>
                <button class="dropdown-item text-primary" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                    Change Password
                </button>
                @* <a class="dropdown-item text-danger" href="~/Account/Logout">
                    Logout
                    <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24" fill="none">
                        <path d="M18.36 6.64a9 9 0 1 1-12.73 0" stroke="#3B82F6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                        <line x1="12" y1="2" x2="12" y2="12" stroke="#EF4444" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a> *@

                <a class="dropdown-item text-danger d-flex align-items-center gap-2" href="~/Account/Logout" style="padding: 0.5rem 1rem;">
                    <span style="
                        width: 40px;
                        height: 40px;
                        display: inline-flex;
                        align-items: center;
                        justify-content: center;
                        border-radius: 50%;
                        background-color: #fef2f2; /* Light red background */
                                                                                        ">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none">
                            <path d="M18.36 6.64a9 9 0 1 1-12.73 0" stroke="#3B82F6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                            <line x1="12" y1="2" x2="12" y2="12" stroke="#EF4444" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                    Logout
                </a>


                <br />
                <a>
                    Theme
                    <select id="theme-selector" name="theme">
                        <option value="light">Light</option>
                        <option value="dark">Dark</option>
                        <option value="blue">Blue</option>
                    </select>
                </a>
            </li>



            @* <li >
                <select id="theme-selector" name="theme">
                    <option value="light">Light</option>
                    <option value="dark">Dark</option>
                    <option value="blue">Blue</option>
                </select>
            </li> *@
        </ul>
    </div>

    @* script for theme *@
    <script>
          // Load theme from cookie on page load
        window.addEventListener('DOMContentLoaded', () => {
            const theme = getCookie("AppTheme") || "light";
            document.getElementById("theme-css").href = `@csspath/css/theme-${theme}.css`;
            document.getElementById("theme-selector").value = theme;
        });

        // When user changes the theme from the dropdown
        document.getElementById("theme-selector").addEventListener("change", function () {
            debugger;
            const selectedTheme = this.value;
                document.getElementById("theme-css").href = `@csspath/css/theme-${selectedTheme}.css`;
                setCookie("AppTheme", selectedTheme, 365);
        });

        // Helper to set cookie
        function setCookie(name, value, days) {
            const d = new Date();
            d.setTime(d.getTime() + (days*24*60*60*1000));
            document.cookie = `${name}=${value};expires=${d.toUTCString()};path=/`;
        }

        // Helper to get cookie
        function getCookie(name) {
            const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
            return match ? match[2] : null;
        }
    </script>


    @* Separate Form to change Password *@
    <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="ChangePassword" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="changePasswordModalLabel">Change Password</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="OldPassword" class="form-label">Old Password</label>
                            <input type="password" name="OldPassword" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label for="NewPassword" class="form-label">New Password</label>
                            <input type="password" name="NewPassword" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label for="ConfirmPassword" class="form-label">Confirm New Password</label>
                            <input type="password" name="ConfirmPassword" class="form-control" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div aria-live="polite" aria-atomic="true" class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
        <div class="toast align-items-center text-white bg-@TempData["ToastType"] border-0" role="alert" id="toastMessage" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    @TempData["ToastMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}




