        function filterSidenav() {
        const input = document.getElementById("sidenavSearch");
        const filter = input.value.trim().toLowerCase();

        const allNavItems = document.querySelectorAll("#mySidenav .tree-nav");

        allNavItems.forEach(nav => {
            const flatLink = nav.querySelector(":scope > a"); // For 'Home', etc.
            const toggleButton = nav.querySelector(".tree-toggle");
            const treeChildren = nav.querySelectorAll(".tree-children");
            let matchFound = false;

            // Case 1: Flat link (like Home)
            if (flatLink) {
                const text = flatLink.textContent.toLowerCase();
                if (text.includes(filter)) {
                    nav.style.display = "";
                    matchFound = true;
                } else {
                    nav.style.display = "none";
                }
            }

            // Case 2: Tree group (like Reports)
            if (toggleButton && treeChildren.length > 0) {
                let anyChildVisible = false;

                treeChildren.forEach(child => {
                    const childLink = child.querySelector("a");
                    if (childLink && childLink.textContent.toLowerCase().includes(filter)) {
                        child.style.display = "block";
                        anyChildVisible = true;
                    } else {
                        child.style.display = "none";
                    }
                });

                if (anyChildVisible) {
                    nav.style.display = "";
                    toggleButton.setAttribute("aria-expanded", "true");
                    toggleButton.querySelector(".arrow").textContent = "▼";
                } else {
                    nav.style.display = filter ? "none" : "";
                    toggleButton.setAttribute("aria-expanded", "false");
                    toggleButton.querySelector(".arrow").textContent = "▶";
                }
            }
        });
    }


</script>

<script>
    function updateDateTime() {
        const now = new Date();
        const options = {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit'
        };
        const formattedDateTime = now.toLocaleString('en-GB', options).replace(',', '');
        document.getElementById("currentDateTime").innerText = formattedDateTime;
    }

    // Initial call and interval setup
    updateDateTime();
    setInterval(updateDateTime, 1000);
</script>
