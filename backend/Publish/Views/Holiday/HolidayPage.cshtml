@model List<EMSSolution.Models.Holiday>


<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>

    @* <link rel="stylesheet" type="text/css" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css" rel="stylesheet" /> *@
    @*<meta name="viewport" content="width=device-width" />
        <title>View</title>*@
    <link rel="stylesheet" href="~/css/Style.css">

    <style>
        .flex {
            display: flex;
            gap: 16px;
        }

        body {
            background-color: #cccccc;
        }

        input:invalid {
            border: 2px solid red;
        }
    </style>
</head>

<body>

    <div class="container" style="margin: -5px auto;">
        <h2 class="text-center" >Holiday Master
            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 64 64" fill="none">
                <circle cx="32" cy="32" r="30" stroke="#FFA500" stroke-width="4" fill="#FFFACD" />
                <path d="M32 50V30" stroke="#8B4513" stroke-width="3" stroke-linecap="round" />
                <path d="M32 30C28 25 22 25 18 28C22 24 28 22 32 26C36 22 42 24 46 28C42 25 36 25 32 30Z" fill="#228B22" />
                <ellipse cx="32" cy="54" rx="20" ry="4" fill="#F4A460" />
            </svg>
        </h2>
        <div asp-validation-summary="All" class="text-bg-danger"></div>
        <div class="form-group mb-3">

            <label for="lName" class="form-label">Holiday Name <span style="color: red;">*</span> </label>
            <input type="text" name="name" id="name" class="form-control" required
                   placeholder="Enter Name [Mandatory]" />

        </div>
        <div class="form-group mb-3">

            <label for="lCode" class="form-label">Holiday Code<span style="color: red;">*</span> </label>
            <input type="text" name="code" id="code" class="form-control" required
                   placeholder="Enter Code [Mandatory]" />

        </div>
        <div class="form-group mb-3">
            <label for="machineid" class="form-label">Holiday Date</label>
            <input type="date" name="ddate" id="ddate" class="form-control" />
        </div>


        <div class="flex">
            <button id="btnsummit" type="submit" class="btn btn-outline-primary" style="width:120px" accesskey="s">Save</button>
            <button id="btnrefresh" type="button" class="btn btn-outline-primary" style="width:120px" accesskey="r">Refresh</button>
            <button id="btnDelete" type="button" class="btn btn-outline-primary" style="width:120px" accesskey="l">Delete</button>
        </div>

    </div>
    <br />
    <div style="display: flex; justify-content: flex-end; margin-bottom: 10px;">
        <input type="text" id="searchBox" class="col-4 display: flex margin-right" placeholder="Search..." onkeyup="searchTable()" />
    </div>

    <div class="table-responsive">
        <table id="myTable" class="table table-striped table-hover">
            <thead>
                <tr>
                    <th> Sno</th>
                    <th> Name</th>
                    <th> Code</th>
                    <th> Date</th>
                    <th hidden> Masterid</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var intRow = 1;

                    foreach (var entry in Model)
                    {

                        <tr>
                            <td>@intRow</td>
                            <td>@entry.sHolidayName</td>
                            <td>@entry.sHolidayCode</td>
                            <td>@entry.dDate.ToString("dd-MM-yyyy")</td>
                            <td hidden>@entry.iMasterid</td>
                        </tr>
                        intRow = intRow + 1;
                    }
                }
            </tbody>
        </table>
    </div>

</body>
</html>
<script src="~/js/GenericFunction.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>

    $(document).ready(function () {
        debugger;
        var iRowNo = 0;
        var currentRow;
        var masterid = 0;
        clearControl();
    });

    $('#btnrefresh').click(function (e) {
        debugger;
        clearControl();
    });
    
    $('#btnDelete').click(function (e) {
        debugger;
        $('#loader').show();
        if (masterid == 0) {
            alert('Select Row to Delete');
            $('#loader').hide();
            return;
        }
        var Masterid = masterid;//$('#masterid').val();
        var requestdata ={ iMasterId: Masterid };
        $.ajax
            ({
                url: '@Url.Action("DeleteHoliday", "Holiday")',
                datatype: 'json',
                type: "post",
                
                cashe: true,
                data: requestdata,
                success: function (response) {
                    debugger;
                    if (response.status == true) {
                        currentRow.remove();
                        clearControl();
                        alert(response.message);
                        $('#loader').hide();
                    }
                    else {
                        $('#loader').hide();
                        alert(response.message);
                    }
                },
                error: function (e) {
                    $('#loader').hide();
                    debugger;
                }
            })
    }); 

    $('#btnsummit').click(function (e) {
        debugger;
        let name =document.getElementById('name');
        name.value = name.value.trim();
        let code=document.getElementById('code');
        code.value = code.value.trim();
        name.setCustomValidity('');
        code.setCustomValidity('');
        if (!name.checkValidity()) {
            name.setCustomValidity('Please enter a Holiday Name');
            name.reportValidity();
            return;
        }
        if (!code.checkValidity()) {
            code.setCustomValidity('Please enter a Holiday Code');
            code.reportValidity();
            return;
        }
        $('#loader').show();
        // if ($('#name').val() == '') {
        //     alert('Provide Name');
        //     $('#loader').hide();
        //     $("#name").focus();
        //     return;
        // }
        // if ($('#code').val() == '') {
        //     alert('Provide Code');
        //     $('#loader').hide();
        //     $("#code").focus();
        //     return;
        // }


        var Name = $('#name').val();
        var Code = $('#code').val();
        var ddate = $('#ddate').val();
        var Masterid = masterid;//$('#masterid').val();

        var requestdata=JSON.stringify({iMasterid: Masterid, 
            sHolidayName: Name, sHolidayCode: Code, dDate: ddate});
        $.ajax
            ({
                url: '@Url.Action("SaveHoliday", "Holiday")',
                datatype: 'json',
                type: "post",
                contentType: "application/json; charset=utf-8",
                cashe: true,
                data: requestdata,
                success: function (response) {
                    debugger;

                    if (response.status == true) {
                        updateTable(response.data, response.isNew)
                        clearControl();
                        alert(response.message);
                        $('#loader').hide();
                    }
                    else {
                        $('#loader').hide();
                        alert(response.message);
                    }
                },
                error: function (e) {
                    $('#loader').hide();
                    debugger;
                }
            })
    });

    $('body').on('click', 'tr', function () {
        debugger;
        var name = $(this).find("td").eq(1).html();
        var code= $(this).find("td").eq(2).html();
        var ddate = $(this).find("td").eq(3).html();
        var parts = ddate.split('-');
        var convertedDate = parts[2] + "-" + parts[1] + "-" + parts[0];
      
        masterid = $(this).find("td").eq(4).html();


        $('#name').val(name);
        $('#code').val(code);
        $('#ddate').val(convertedDate);
        //$('#masterid').val(masterid);

        iRowNo = $(this).closest("tr")[0].rowIndex;
        currentRow = $(this).closest("tr");

    });
    function clearControl() {
        $('#name').val('');
        $('#code').val('');
        $('#ddate').val('');
        //$('#masterid').val('');
        masterid = 0;
        $("#name").focus();
    }
    function updateTable(res, isNew) {
        debugger;
        if (isNew == 1) {
            //get table total rows
            var rowCount = $('#myTable tr').length;

            //$('#myTable tbody').empty()
            for (let i = 0; i < res.length; i++) {
                var parts = res[0].dDate.substring(0,10).split('-');
                var convertedDate = parts[2] + "-" + parts[1] + "-" + parts[0];
                $('#myTable').append('<tr>' +
                    '<td>' + (rowCount) + '</td>' +
                    '<td >' + res[i].sHolidayName + '</td > ' +
                    '<td >' + res[i].sHolidayCode + '</td > ' +
                    '<td >' + convertedDate + '</td > ' +
                    '<td style="display:none;">' + res[i].iMasterid + '</td > ' +
                    '</tr>');
            }
        }
        else {

            $("#myTable").val(currentRow.find("td:eq(1)").text(res[0].sHolidayName));
            $("#myTable").val(currentRow.find("td:eq(2)").text(res[0].sHolidayCode));
            
            var parts = res[0].dDate.substring(0,10).split('-');
            var convertedDate = parts[2] + "-" + parts[1] + "-" + parts[0];
            //$("#myTable").val(currentRow.find("td:eq(3)").text(res[0].dDate));
            $("#myTable").val(currentRow.find("td:eq(3)").text(convertedDate));
            $("#myTable").val(currentRow.find("td:eq(4)").text(res[0].iMasterid));

        }
    }
</script>