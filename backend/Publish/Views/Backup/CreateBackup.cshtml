@{
    ViewData["Title"] = "Database Backup";
}

<h2>Database Backup</h2>

@* <form id="backupForm" method="post"> *@
<div class="container">
    <button type="submit" id="summit" class="btn btn-primary">Create Backup</button>
</div>
@* </form> *@

<div id="result" class="mt-3"></div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
   
    $(document).ready(function () {
        $("#summit").click(function (e) {
            debugger;
            e.preventDefault();
            $.post("/Backup/getBackup", function (res) {
                if (res.success) {
                   
                    $("#result").html(
                        `<div class="alert alert-success">
                            Backup created successfully.
                            <a href="${res.downloadUrl}" class="btn btn-link">Download Backup</a>
                        </div>`);
                } else {
                    $("#result").html(
                        `<div class="alert alert-danger">Error: ${res.message}</div>`);
                }
            });
        });
    });

