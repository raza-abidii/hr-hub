@using System.Globalization
@model List<EMSSolution.Models.TimecardAdvance>
@{
    int year = ViewBag.Year;
    int month = ViewBag.Month;
    var daysInMonth = DateTime.DaysInMonth(year, month);
    var firstDayOfWeek = (int)new DateTime(year, month, 1).DayOfWeek;
    var date = new DateTime(year, month, 1);
    var currentYear = DateTime.Now.Year;
    var years = Enumerable.Range(currentYear - 5, 11).ToList();
    var prevDate = new DateTime(year, month, 1).AddMonths(-1);
    var nextDate = new DateTime(year, month, 1).AddMonths(1);
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!DOCTYPE html>
<html>
<head>
    <style>
        .table-sm th, .table-sm td {
            padding: 0.2rem;
        }

        .card {
            font-size: 12px;
            border-radius: 10px;
        }

        .card-header h5 {
            font-size: 14px;
        }

        .calendar-cell {
            cursor: pointer;
            font-size: 11px;
            padding: 2px;
        }

        .bg-present {
            background-color: #c8e6c9 !important;
        }

        .bg-leave {
            background-color: #fff9c4 !important;
        }

        .bg-absent {
            background-color: #ffcdd2 !important;
        }

        .bg-late {
            background-color: #ffab91 !important;
        }

        .bg-holiday {
            background-color: #b2dfdb !important;
        }

        .calendar-wrapper {
            max-width: 300px;
            width: 100%;
            margin: auto;
        }

        .nav-controls {
            display: flex;
            justify-content: space-between;
            margin-bottom: 0.5rem;
        }

        select.form-select-sm, .btn-sm {
            font-size: 12px;
            padding: 0.2rem 0.4rem;
        }
    </style>
</head>
<body>
    <div class="calendar-wrapper">
        <!-- Navigation and Dropdowns -->
        <div class="card shadow-sm mb-2" style="margin-top:12px;">
            <div class="card-body py-2">
                <!-- Month/Year Dropdowns -->
                <form method="get" asp-action="TimecardAdvanced"  class="d-flex gap-2 align-items-center">
                    <!-- Month Dropdown -->
                    <select name="month" class="form-select form-select-sm ">
                        @for (int m = 1; m <= 12; m++)
                        {
                            var selected = (m == month) ? "selected" : "";
                            if (selected == "")
                            {
                                <option value="@m">@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                            }
                            else
                            {
                                <option value="@m" selected>@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                            }
                        }
                    </select>

                    <!-- Year Dropdown -->
                    <select name="year" class="form-select form-select-sm">
                        @foreach (var y in years)
                        {
                            var selected = (y == year) ? "selected" : "";
                            if (selected == "")
                            {
                                <option value="@y">@y</option>
                            }
                            else
                            {
                                <option value="@y" selected>@y</option>
                            }
                        }
                    </select>

                    <button type="submit" class="btn btn-sm btn-primary">Go</button>
                </form>


            </div>
        </div>

        <div class="card shadow-sm" style="margin-top:-8px;">
            <div class="card-header text-center bg-primary text-white py-1">

                <h5 class="mb-0 d-flex justify-content-between align-items-center">
                    <a asp-action="TimecardAdvanced"
                       asp-route-year="@prevDate.Year"
                       asp-route-month="@prevDate.Month"
                       class="btn btn-sm btn-outline-light px-2 py-0">&laquo;</a>

                    <span>@date.ToString("MMMM yyyy")</span>

                    <a asp-action="TimecardAdvanced"
                       asp-route-year="@nextDate.Year"
                       asp-route-month="@nextDate.Month"
                       class="btn btn-sm btn-outline-light px-2 py-0">&raquo;</a>
                </h5>
            </div>

            <div class="card-body p-0">
                <div style="overflow-x: auto;">
                    <table class="table table-sm table-bordered text-center mb-0">
                        <thead>
                            <tr>
                                @foreach (var day in Enum.GetValues(typeof(DayOfWeek)))
                                {

                                    <th>@CultureInfo.CurrentCulture.DateTimeFormat.AbbreviatedDayNames[(int)day]</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int dayCounter = 1;
                                bool started = false;
                            }
                            @for (int week = 0; dayCounter <= daysInMonth;)
                            {
                                <tr>
                                    @for (int i = 0; i < 7; i++)
                                    {
                                        if (!started && i == firstDayOfWeek)
                                            started = true;

                                        if (started && dayCounter <= daysInMonth)
                                        {
                                            var currentDate = new DateTime(year, month, dayCounter);
                                            //var entry = Model.FirstOrDefault(t => Convert.ToDateTime(t.LogDate) == currentDate.Date);
                                            var entry = Model.Where(d => d.LogDate == currentDate.Date.ToString("dd-MM-yyyy")).ToList();
                                            
                                            string? remark = entry != null && entry.Count > 0 ? entry[0].Remakrs : string.Empty;
                                            string cellClass = "calendar-cell";
                                            if (remark.Contains("Public Holiday"))
                                            {
                                                cellClass += " bg-holiday";
                                            }
                                            else if (remark.Contains("Absent"))
                                            {
                                                cellClass += " bg-absent";
                                            }
                                            else if (remark.Contains("Late In"))
                                            {
                                                cellClass += " bg-late";

                                            }
                                            else if (remark.Contains("On Time"))
                                            {
                                                cellClass += " bg-present";
                                            }
                                            else if (remark.Contains("Leave"))
                                            {
                                                cellClass += " bg-leave";
                                            }
                                                    
                                            <td class="@cellClass"
                                                data-bs-toggle="tooltip"
                                                data-bs-html="true"
                                                data-bs-placement="top"
                                                title="Login: @(entry.Any() ? entry[0].InTime.ToString("HH:mm") : "--")<br/>
                                                Logout: @(entry.Any() ? entry[0].OutTime.ToString("HH:mm") : "--")<br/>
                                                Remarks: @(entry.Any() ? entry[0].Remakrs : "--")">

                                                <strong>@dayCounter</strong><br />
                                                @if (entry != null)
                                                {
                                                    @*  <span hidden>Login: @(entry[0].InTime.ToString("HH:mm") ?? "--")</span>

                                                <br />
                                                <span hidden>Logout: @(entry[0].OutTime.ToString("HH:mm") ?? "--")</span>
                                                <br /> *@
                                                    <span>@(entry[0].Remakrs)</span>
                                                }
                                                else
                                                {   
                                                    <span class="text-danger">Absent</span>
                                                }
                                                                                    </td>
                                            dayCounter++;
                                        }
                                        else
                                        {
                                            <td></td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</body>
</html>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const cells = document.querySelectorAll(".calendar-cell");

        // Initialize tooltip on all cells
        cells.forEach(cell => {
            const tooltip = new bootstrap.Tooltip(cell, {
                trigger: 'manual', // We will handle showing manually
                placement:'auto',
                html: true
            });

            cell.addEventListener("click", function (e) {
                // Hide all other tooltips
                document.querySelectorAll('.calendar-cell').forEach(el => {
                    bootstrap.Tooltip.getInstance(el)?.hide();
                });
            debugger

            var rem= cell.querySelector("span:not([hidden])").textContent
            if (rem !== 'Absent' && rem !== 'Public Holiday' && rem !== 'Leave')
            {
                // Show clicked one
                tooltip.show();
            }

            // Hide again after 3 seconds
            setTimeout(() => tooltip.hide(), 3000);
            });
        });
    });
</script>
