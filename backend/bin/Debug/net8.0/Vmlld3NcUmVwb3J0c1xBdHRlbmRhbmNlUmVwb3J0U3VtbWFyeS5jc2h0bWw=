@{
    var months = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.MonthNames;
}
@{
    // ViewBag.Employees is assumed to be a List of objects with "Name" and "Code"
    var employeesJson = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Employees);
}

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendance Report Summary</title>
   

 

    <style>
        #tooltip {
            position: absolute;
            background: #333;
            color: #fff;
            padding: 5px 10px;
            border-radius: 4px;
            font-size: 12px;
            display: none;
            pointer-events: none;
            z-index: 1000;
        }


        table.attendance-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 800px;
        }

        .attendance-table thead {
            background-color: #1e88e5;
            color: white;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .attendance-table th, .attendance-table td {
            padding: 10px 14px;
            text-align: center;
            border-bottom: 1px solid #e0e0e0;
            white-space: nowrap;
        }

        .attendance-table tbody tr:nth-child(odd) {
            background-color: #f9f9f9;
        }

        .attendance-table tbody tr:hover {
            background-color: #f1f7ff;
        }

        .employee-name {
            text-align: left;
            font-weight: 600;
            color: #333;
        }

        .select2-container {
            width: 100% !important;
        }

        .select-dropdown {
            width: 100%;
        }

    </style>

    <link rel="stylesheet" href="~/css/Style.css">
</head>
<body>

    <div class="container">

        
        <h4 class="text-center d-flex justify-content-center align-items-center gap-2">

            Employee Attendance Report Summary
            <svg width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="4" width="18" height="16" rx="2" stroke="#4A90E2" stroke-width="2" />
                <line x1="3" y1="8" x2="21" y2="8" stroke="#4A90E2" stroke-width="2" />
                <circle cx="8" cy="12" r="1.5" fill="#4A90E2" />
                <circle cx="12" cy="12" r="1.5" fill="#4A90E2" />
                <circle cx="16" cy="12" r="1.5" fill="#4A90E2" />
                <circle cx="8" cy="16" r="1.5" fill="#4A90E2" />
                <path d="M15 19l1.5 1.5L20 17" stroke="#3CB371" stroke-width="2" stroke-linecap="round" />
            </svg>
        </h4>

        <div class="form-group mb-3">
            <label class="bold-label d-block mb-1">Report Type:</label>
            <div class="d-flex gap-3">
                <label class="mb-0">
                    <input type="radio" name="ReportType" value="EmployeeWise" checked onchange="toggleAllocationView()" />
                    Employee-wise
                </label>
                <label class="mb-0">
                    <input type="radio" name="ReportType" value="BranchWise" onchange="toggleAllocationView()" />
                    Branch-wise
                </label>
            </div>
        </div>
        <div id="employeeDropdown" class="form-group mb-3">
            <label class="bold-label">Employee</label>
            <select id="employee" name="employee" class="select-dropdown">
                <option>Select Employee</option>
                @foreach (var employee in ViewBag.Employees)
                {
                    <option value="@employee.iMasterid">@employee.sEmployeeName</option>
                }
            </select>
        </div>
        <div id="branchDropdown" class="form-group mb-3" style="display: none; ">
            <label class="bold-label">Branch</label>
            <select id="branch" name="branch" class="select-dropdown">
                <option>Select Branch</option>
                @foreach (var branch in ViewBag.Branch)
                {
                    <option value="@branch.iMasterid">@branch.sName</option>
                }
            </select>
        </div>
        <div class="flex gap-4 mb-3">
            <!-- Month Dropdown -->
            <div class="flex-1">
                <label class="block text-sm font-medium text-gray-700">Month</label>
                <select id="monthSelect" class="select-dropdown w-full">
                    @for (int i = 1; i <= 12; i++)
                    {
                        var selectedmonthName = (i == ViewBag.selectedMonth ? "selected" : "");
                        if (selectedmonthName == "")
                        {
                            <option value="@i">@months[i - 1]</option>
                        }
                        else
                        {
                            <option value="@i" selected>@months[i - 1]</option>
                        }
                    }
                </select>
            </div>

            <!-- Year Dropdown -->
            <div class="flex-1">
                <label class="block text-sm font-medium text-gray-700">Year</label>
                <select id="yearSelect" class="select-dropdown w-full">
                    @for (int y = DateTime.Now.Year - 5; y <= DateTime.Now.Year + 5; y++)
                    {
                        var yearName = (y == ViewBag.SelectedYear ? "selected" : "");
                        if (yearName == "")
                        {
                            <option value="@y">@y</option>
                        }
                        else
                        {
                            <option value="@y" selected>@y</option>
                        }
                    }
                </select>
            </div>
        </div>
        @* </div> *@


        <div class="flex">
            @*   <button id="display" class="bg-blue-600 text-white px-4 py-2 rounded-xl hover:bg-blue-700">Display</button>
                    <button id="exportexcel" class="bg-green-600 text-white px-4 py-2 rounded-xl hover:bg-green-700">Export to Excel</button> *@
            <button id="display" type="button" class="btn btn-outline-primary" style="width:135px;height:40px" accesskey="s">Display</button>
            <button id="pdf" type="button" class="btn btn-outline-primary" style="width:135px;height:40px" accesskey="r">PDF</button>
            @* <button id="printReport" type="button" class="btn btn-outline-primary" style="width:135px;height:40px" accesskey="p" onclick="printReportData()">Print</button> *@

        </div>
    </div>

   @*  <div class="container"> *@
    <div class="attendance-container overflow-x-auto p-4 bg-white shadow rounded-lg">
        <div class="table-responsive">
        <table id="myTable" class="attendance-table min-w-full text-sm text-left text-gray-700 border border-gray-200" style="font-size:10px">
            <thead class="bg-gray-100 text-xs uppercase text-gray-600" id="tableHeader">
                <tr>
                    <th class="px-2 py-1 border-r border-gray-200">Emp Name</th>
                    <th class="px-2 py-1 border-r border-gray-200">Emp Code</th>
                    <th class="px-2 py-1 border-r border-gray-200">Days in Month</th>
                    <th class="px-2 py-1 border-r border-gray-200">Days Present</th>
                    <th class="px-2 py-1 border-r border-gray-200">Holiday</th>
                    <th class="px-2 py-1 border-r border-gray-200">Leave</th>
                    <th class="px-2 py-1 border-r border-gray-200">Paid Days</th>

                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                <tr>
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">XXX</td>
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">ZZZ</td>
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">30</td>
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">23</td>
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">4</td>
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">3</td>
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">30</td>
                </tr>
            </tbody>
        </table>
        </div>
    </div>



</body>

</html>

<script src="/js/GenericFunction.js"></script>
<script>
     function toggleAllocationView() {
        const isEmployeeWise = document.querySelector('input[name="ReportType"]:checked').value === "EmployeeWise";
        document.getElementById("employeeDropdown").style.display = isEmployeeWise ? "block" : "none";
        document.getElementById("branchDropdown").style.display = isEmployeeWise ? "none" : "block";
    }

        $(document).ready(function () {
            $('#employee, #branch, #monthSelect, #yearSelect').select2({ allowClear: true });
            focusonselectcontrol("#employee");
            focusonselectcontrol("#branch");
            focusonselectcontrol("#monthSelect");
            focusonselectcontrol("#yearSelect");
        });

        $("#display").click(function () {
            var employee = $("#employee").val();
            var employeename = $("#employee").find('option:selected').text();
            var branch = $("#branch").val();
            var branchname = $("#branch").find('option:selected').text();
            var month = $("#monthSelect").val();
            var year = $("#yearSelect").val();
            var reportType = $("input[name='ReportType']:checked").val();

            if (reportType == "EmployeeWise" && (employeename == 'Select Employee' || employeename == '' || !month || !year)) {
                alert("Please select employee, Month, Year.");
                return;
            } else if (reportType == "BranchWise" && (branchname == 'Select Branch' || branchname == '' || !month || !year)) {
                alert("Please select branch, Month, Year.");
                return;
            }

            $.ajax({
                url: '@Url.Action("GetAttendanceReportData", "AttendanceReportSummary")',
                type: 'post',
                data: {
                    iEmployee: employee,
                    iBranch: branch,
                    iMonth: month,
                    iYear: year,
                    EmployeeName: employeename,
                    BranchName: branchname,
                    ReportType: reportType
                },
                success: function (response) {
                    if (response.success == true)
                        displayData(response.data);
                    else
                        alert(response.message);
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching data:", error);
                }
            });
        });

        function displayData(data) {
            const tbody = document.querySelector("#myTable tbody");
            $('#myTable tbody').empty();
            data.forEach(item => {
                const row = document.createElement("tr");
                row.innerHTML = `
                <td>${item.EmployeeName}</td>
                <td>${item.EmployeeCode}</td>
                <td>${item.DaysInMonth}</td>
                <td>${item.Present}</td>
                <td>${item.Holiday}</td>
                <td>${item.Leave}</td>
                <td>${item.PaidDays}</td>
                `;
                tbody.appendChild(row);
            });
        }
</script>

<script>
    document.getElementById("pdf").addEventListener("click", function () {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();

        // Add logo (optional)
        //const logoUrl = window.location.origin + "/image/sfon1.png";
        const logoUrl='@Url.Content("~/image/sfon1.png")';
        const img = new Image();
        img.src = logoUrl;

        img.onload = function () {
            doc.addImage(img, 'PNG', 80, 0, 15, 15); // Centered logo
            doc.text("Employee Attendance Report Summary", 105, 20, { align: 'center' });

            // Get table
            // doc.autoTable({
            //     html: '#myTable',
            //     startY: 50,
            //     styles: { fontSize: 8 },
            //     headStyles: { fillColor: [30, 136, 229] }
            // });

                doc.autoTable({
                html: '#myTable',
                startY: 25,
                styles: {
                    fontSize: 8,
                    lineWidth: 0.1, // Add border width
                    lineColor: [0, 0, 0] // Black border color
                },
                headStyles: {
                    fillColor: [30, 136, 229],
                    textColor: 255,
                    lineWidth: 0.1,
                    lineColor: [0, 0, 0]
                },
                bodyStyles: {
                    lineWidth: 0.1,
                    lineColor: [0, 0, 0]
                },
                tableLineWidth: 0.1,
                tableLineColor: [0, 0, 0],
            });

            doc.save("Attendance_Report.pdf");
        };

        img.onerror = function () {
            alert("Failed to load logo. PDF will be generated without it.");

            doc.text("Employee Attendance Report Summary", 105, 20, { align: 'center' });
            doc.autoTable({
                html: '#myTable',
                startY: 25,
                styles: { fontSize: 8 },
                headStyles: { fillColor: [30, 136, 229] }
            });

            doc.save("Attendance_Report.pdf");
        };
    });
</script>

<script>
    // Parse the Razor-passed employees into JavaScript
    const employees = @Html.Raw(employeesJson);
    const select = document.getElementById("employee");

    let showCodeOnly = false;

    function renderOptions() {
        const selectedValue = select.value;
        select.innerHTML = "";

         const option = document.createElement("option");
            option.value = 0;
            option.text = "Select Employee";
            select.appendChild(option);

        employees.forEach(emp => {
            const option = document.createElement("option");
            option.value = emp.iMasterid;
            option.text = showCodeOnly ? emp.sEmployeeCode : emp.sEmployeeName;
            select.appendChild(option);
        });

        select.value = "Select Employee";
    }

    renderOptions();

    document.addEventListener("keydown", function (e) {
        // if (e.altKey && e.key === "F2") {
        if (e.key === "F2") {
            showCodeOnly = !showCodeOnly;
            renderOptions();
        }
    });
</script>

