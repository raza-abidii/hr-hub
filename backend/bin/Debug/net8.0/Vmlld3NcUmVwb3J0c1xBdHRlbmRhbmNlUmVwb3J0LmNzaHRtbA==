@{
    var months = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.MonthNames;
}
@{
    // ViewBag.Employees is assumed to be a List of objects with "Name" and "Code"
    var employeesJson = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Employees);
    var startMonth = ViewBag.startMonth;
}

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendance Report</title>


    <style>
        #tooltip {
            position: absolute;
            background: #333;
            color: #fff;
            padding: 5px 10px;
            border-radius: 4px;
            font-size: 12px;
            display: none;
            pointer-events: none;
            z-index: 1000;
        }



        table.attendance-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 800px;
        }

        .attendance-table thead {
            background-color: #1e88e5;
            color: white;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .attendance-table th, .attendance-table td {
            padding: 10px 14px;
            text-align: center;
            border-bottom: 1px solid #e0e0e0;
            white-space: nowrap;
        }

        .attendance-table tbody tr:nth-child(odd) {
            background-color: #f9f9f9;
        }

        .attendance-table tbody tr:hover {
            background-color: #f1f7ff;
        }

        .employee-name {
            text-align: left;
            font-weight: 600;
            color: #333;
        }

        .select2-container {
            width: 100% !important;
        }

        .select-dropdown {
            width: 100%;
        }
    </style>

    <link rel="stylesheet" href="~/css/Style.css">
</head>
<body>
    <div id="loader-overlay">
        <img src="../Content/progress.gif" class="loader-img" />
    </div>

    <div class="container">

        <h4 class="text-center d-flex justify-content-center align-items-center gap-2">
            Employee Attendance Report
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="25" height="25" role="img" aria-label="Monthly attendance report">
                
                <!-- background calendar -->
                <rect x="2" y="4" width="20" height="18" rx="2" fill="#E3F2FD" stroke="#1565C0" stroke-width="1.5" />
                <rect x="3" y="7" width="18" height="3" rx="1" fill="#1565C0" />
                <path d="M7 2v3M17 2v3" stroke="#1565C0" stroke-width="1.5" stroke-linecap="round" />
                <!-- inside: M -->
                <text x="6" y="16" font-family="Arial, Helvetica, sans-serif" font-size="7" fill="#1565C0" font-weight="bold">M</text>
                <!-- report bars -->
                <rect x="13" y="14" width="2" height="4" rx="0.3" fill="#43A047" />
                <rect x="16" y="12" width="2" height="6" rx="0.3" fill="#43A047" />
                <rect x="19" y="10" width="2" height="8" rx="0.3" fill="#43A047" />
            </svg>

        </h4>

        @* <div class="grid grid-cols-4 md:grid-cols-4 gap-4 mb-4"> *@
        @*  <div class="form-group mb-3">
            <label class="bold-label">Report Type:</label><br />
            <label><input type="radio" name="ReportType" value="EmployeeWise" checked onchange="toggleAllocationView()" /> Employee-wise</label>
            <label><input type="radio" name="ReportType" value="CategoryWise" onchange="toggleAllocationView()" /> Category-wise</label>
        </div> *@
        <div class="form-group mb-3">
            <label class="bold-label d-block mb-1">Report Type:</label>
            <div class="d-flex gap-3">
                <label class="mb-0">
                    <input type="radio" name="ReportType" value="EmployeeWise" checked onchange="toggleAllocationView()" />
                    Employee-wise
                </label>
                <label class="mb-0">
                    <input type="radio" name="ReportType" value="BranchWise" onchange="toggleAllocationView()" />
                    Branch-wise
                </label>
            </div>
        </div>
        <div id="employeeDropdown" class="form-group mb-3">
            <label class="bold-label">Employee</label>
            <select id="employee" name="employee" class="select-dropdown" multiple>
                <option>Select Employee</option>
                @foreach (var employee in ViewBag.Employees)
                {
                    <option value="@employee.iMasterid">@employee.sEmployeeName</option>
                }
            </select>
        </div>
        <div id="branchDropdown" class="form-group mb-3" style="display: none; ">
            <label class="bold-label">Branch</label>
            <select id="branch" name="branch" class="select-dropdown">
                <option>Select Branch</option>
                @foreach (var branch in ViewBag.Branch)
                {
                    <option value="@branch.iMasterid">@branch.sName</option>
                }
            </select>
        </div>
        <div class="flex gap-4 mb-3">
            <!-- Month Dropdown -->
            <div class="flex-1">
                <label class="block text-sm font-medium text-gray-700">Month</label>
                <select id="monthSelect" class="select-dropdown w-full">
                    @for (int i = 1; i <= 12; i++)
                    {
                        var selectedmonthName = (i == ViewBag.selectedMonth ? "selected" : "");
                        if (selectedmonthName == "")
                        {
                            <option value="@i">@months[i - 1]</option>
                        }
                        else
                        {
                            <option value="@i" selected>@months[i - 1]</option>
                        }
                    }
                </select>
            </div>

            <!-- Year Dropdown -->
            <div class="flex-1">
                <label class="block text-sm font-medium text-gray-700">Year</label>
                <select id="yearSelect" class="select-dropdown w-full">
                    @for (int y = DateTime.Now.Year - 5; y <= DateTime.Now.Year + 5; y++)
                    {
                        var yearName = (y == ViewBag.SelectedYear ? "selected" : "");
                        if (yearName == "")
                        {
                            <option value="@y">@y</option>
                        }
                        else
                        {
                            <option value="@y" selected>@y</option>
                        }
                    }
                </select>
            </div>
        </div>
        @* </div> *@


        <div class="flex">
            <button id="display" type="button" class="btn btn-outline-primary" style="width:135px;height:40px" accesskey="s">Display</button>
            <button id="exportexcel" type="button" class="btn btn-outline-primary" style="width:135px;height:40px" accesskey="r">Export to Excel</button>
            @* <button id="printReport" type="button" class="btn btn-outline-primary" style="width:135px;height:40px" accesskey="p">Print</button> *@
        </div>
    </div>

    <div class="attendance-container overflow-x-auto p-4 bg-white shadow rounded-lg">
        <table id="myTable" class="attendance-table min-w-full text-sm text-left text-gray-700 border border-gray-200">
            <thead class="bg-gray-100 text-xs uppercase text-gray-600" id="tableHeader">
                <tr>
                    <th class="px-2 py-1 border-r border-gray-200">Employee Name</th>
                    <th class="px-2 py-1 border-r border-gray-200">Employee Id</th>
                    <th class="px-2 py-1 border-r border-gray-200">Branch Name</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200" id="tableBody">
                <tr >
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">XXX</td>
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">ZZZ</td>
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">BBB</td>
                </tr>
            </tbody>
        </table>
    </div>

    <br />
    <div id="legend" style="display: flex; flex-wrap: wrap; gap: 1rem; padding: 1rem; border: 1px solid #ccc; border-radius: 8px;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <div style="width: 20px; height: 20px; background-color: #0DCAF0;"></div>
            <span>Public Holiday</span>
        </div>

        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <div style="width: 20px; height: 20px; background-color: #F19E9E;"></div>
            <span>Late In</span>
        </div>

        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <div style="width: 20px; height: 20px; background-color: #9D5050;"></div>
            <span>Early Out</span>
        </div>

        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <div style="width: 20px; height: 20px; background-color: #E58110;"></div>
            <span>Late In/Early Out</span>
        </div>
        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <div style="width: 20px; height: 20px; background-color: #e71818;"></div>
            <span>Absent</span>
        </div>
        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <div style="width: 20px; height: 20px; background-color: #155724;"></div>
            <span>Ontime</span>
        </div>
        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <div style="width: 20px; height: 20px; background-color: #28a745;"></div>
            <span>Leave</span>
        </div>

    </div>

    <div id="tooltip"></div>

    <br />

</body>

</html>

<script src="/js/GenericFunction.js"></script>
<script>

     $(document).ready(function() {
        $('#employee').select2({
            placeholder: "Select employee",
            allowClear: true
        });
        $('#branch').select2({
            placeholder: "Select Branch",
            allowClear: true
        });
        $('#monthSelect').select2({
            placeholder: "Select Month",
            allowClear: true
        });
        $('#yearSelect').select2({
            placeholder: "Select Year",
            allowClear: true
        });

        focusonselectcontrol("#employee");
        focusonselectcontrol("#branch");
        focusonselectcontrol("#monthSelect");
        focusonselectcontrol("#yearSelect");

        $('#loader-overlay').hide();

     });

     // Event listener for the display button
     //ajax call attendanceReport/GetAttendanceReportData
        $("#display").click(function () {
            debugger;
            var displayType = $("input[name='DisplayType']:checked").val();

            var startday= '@ViewBag.startMonth';
            if (startday == 1)
            {
                generateTableHeaderdaystartfrom1();
            }
            else
            {
                generateTableHeader();
            }


            //generateTableHeader();
            var employee = $("#employee").val();
            var employeename=$("#employee").find('option:selected').text()
            var branch = $("#branch").val();
            var branchname=$("#branch").find('option:selected').text()
            var month = $("#monthSelect").val();
            var year = $("#yearSelect").val();
            var reportType = $("input[name='ReportType']:checked").val();
            if(reportType=="EmployeeWise")
            {
                if (!month || !year) {
                    alert("Please select Month,Year ");
                    return;
                }
            }
            else
            {
                if (employeename=='Select Branch' || !month || !year) {
                    alert("Please select Branch, Month,Year ");
                    return;
                }
               
            }

            $('#loader-overlay').show();
            debugger;
            $.ajax({
                url: '@Url.Action("GetAttendanceReportData", "AttendanceReport")',
                type: 'post',
                data: {
                    iEmployee: employee,
                    iBranch: branch,
                    iMonth: month,
                    iYear: year,
                    EmployeeName:employeename,
                    BranchName:branchname,
                    ReportType: reportType
                },
                success: function (response) {
                    debugger;
                    if(response.success==true)
                        if (startday == 1)
                            displayDataDay1(response.data)
                        else
                            displayData(response.data)

                    else
                        alert (response.message);

                        $('#loader-overlay').hide();
                },
                error: function (xhr, status, error) {
                    $('#loader-overlay').hide();
                    console.error("Error fetching data:", error);
                }
            });
        });

        //exporttoexcel
        $("#exportexcel").click(function () {
            debugger;

            var month = $("#monthSelect").find('option:selected').text();
            var year = $("#yearSelect").find('option:selected').text();

            $('#loader-overlay').show();
            debugger;
            var tabledata= getTableData();
            $.ajax({
                url: '@Url.Action("ExportToExcel", "AttendanceReport")',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({
                    attendanceData: tabledata,
                    month: month,
                    year: year
                }),
                xhrFields: {
                    responseType: 'blob' // Excel file response
                },
                success: function (data, status, xhr) {
                    debugger;
                    // Try to get filename from content-disposition
                    var disposition = xhr.getResponseHeader('Content-Disposition');
                    var matches = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/.exec(disposition);
                    var filename = (matches != null && matches[1]) ? matches[1].replace(/['"]/g, '') : "AttendanceReport.xlsx";

                    // Create a link and download
                    var blob = new Blob([data], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                    var url = window.URL.createObjectURL(blob);

                    var a = document.createElement('a');
                    a.href = url;
                    a.download = filename;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    window.URL.revokeObjectURL(url);
                    $('#loader-overlay').hide();
                },
                error: function (xhr, status, error) {
                    $('#loader-overlay').hide();
                    console.log("Error fetching data:", error);
                }
            });
        });

        function getTableData() {
            const table = document.getElementById("myTable");
            const data = [];

            var headers = [];
            $('table thead th').each(function() {
                headers.push($(this).text().trim());
            });

            
            for (let i = 1; i < table.rows.length; i++) {
                const row = table.rows[i];
                const rowData = {};
                for (let j = 0; j < row.cells.length; j++) {
                    const cell = row.cells[j];
                    if (j === 0) {
                        rowData.EmployeeName = cell.textContent;
                    } else if (j === 1) {
                        rowData.EmployeeId = cell.textContent;
                    } else if (j === 2) {
                        rowData.BranchName = cell.textContent;
                    } else {
                        rowData[`day-${j - 2}`] = cell.textContent;
                        rowData[`day-${j - 2}bg`] = cell.style.backgroundColor;
                        rowData[`day-${j - 2}day`] = headers[j];

                    }
                }
                data.push(rowData);
            }
            return data;
        }

        function displayData(data)
        {
            debugger;
            const month = document.getElementById("monthSelect").value;
            const year = document.getElementById("yearSelect").value;
            const daysInMonth = new Date(year, month, 0).getDate();

            const tbody = document.querySelector("#myTable tbody");
            $('#myTable tbody').empty();
            data.forEach(item => {
                const row = document.createElement("tr");
                row.innerHTML = `
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">${item.EmployeeName}</td>
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">${item.EmployeeId}</td>
                     <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">${item.BranchName}</td>
                `;

                let i=0;
                // Add dynamic date cells
                //for (let i = 1; i <= daysInMonth; i++) {
                // Calculate the start date (26th of the previous month)
                const startDate = new Date(year, month - 2, @ViewBag.startMonth);
                // Calculate the end date (25th of the current month)
                const endDate = new Date(year, month-1, @ViewBag.startMonth-1);
                // Loop through the range from startDate to endDate
                for (let date = startDate; date <= endDate; date.setDate(date.getDate() + 1)) {
                    i=String(date.getDate()).padStart(2, '0');
                    i=parseInt(i)+1;
                    const cell = document.createElement("td");
                    cell.className = "px-2 py-1 whitespace-nowrap border-r border-gray-100";
                    cell.textContent =item[`day-${i-1}-in`] + '-' + item[`day-${i-1}-out`]; // Adjust according to your data structure
                    //change cell color
                    if(item[`day-${i-1}-ph`]=="Sunday")
                    {
                        cell.style.backgroundColor = "#0dcaf0";
                        cell.textContent="Sunday";
                    }
                    if(item[`day-${i-1}-ph`]=="Weekly Off")
                    {
                        cell.style.backgroundColor = "#0dcaf0";
                        cell.textContent="Weak-Off";
                    }
                    else if(item[`remarks-${i-1}`]=="Late In/Early Out")
                        cell.style.backgroundColor = "#E58110";
                    else if(item[`remarks-${i-1}`]=="Late In")
                        cell.style.backgroundColor = "#F19E9E";
                    else if(item[`remarks-${i-1}`]=="Early Out")
                        cell.style.backgroundColor = "#9D5050";
                    else if(item[`remarks-${i-1}`]=="Ontime")
                        cell.style.backgroundColor = "#155724";//ontime
                    else if(item[`remarks-${i-1}`]=="")
                    {
                       
                        cell.style.backgroundColor = "#e71818";//Absent
                        cell.style.color = "#721c24";
                        cell.textContent='Absent';
                        

                    }

                    if (item[`remarks-${i-1}`]?.includes("Leave")) {
                        // Leave Type Not Specified then;//
                        cell.style.backgroundColor = "#28a745";//Earned Leave
                        cell.textContent='Leave';
                    }
                    if(item[`remarks-${i-1}`]=="LeaveCL")
                    {
                       //casual Leave
                        cell.textContent='Leave-CL';
                    }
                    if(item[`remarks-${i-1}`]=="LeaveEL")
                    {
                        //Earned Leave
                        cell.textContent='Leave-EL';
                    }


                    cell.style.color = "white";
                    row.appendChild(cell);
                }
                tbody.appendChild(row);
            });


        }

        function displayDataDay1(data)
        {
             debugger;
            const month = document.getElementById("monthSelect").value;
