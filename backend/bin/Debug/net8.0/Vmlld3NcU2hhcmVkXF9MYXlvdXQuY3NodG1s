<script>
    function openNav() {
        document.getElementById("mySidenav").style.width = "270px";
        document.getElementById("topstrip").style.marginLeft = "270px";
        document.getElementById("mainWrapper").classList.add("sidenav-open");
    }

    function closeNav() {
        document.getElementById("mySidenav").style.width = "0";
        document.getElementById("topstrip").style.marginLeft = "0";
        document.getElementById("mainWrapper").classList.remove("sidenav-open");
    }

    @* toggel treeItems *@
     document.addEventListener("DOMContentLoaded", function () {
         //debugger;
         document.querySelectorAll(".tree-toggle").forEach(toggle => {
             toggle.addEventListener("click", function () {
                 const expanded = this.getAttribute("aria-expanded") === "true";
                 this.setAttribute("aria-expanded", !expanded);

                 const arrow = this.querySelector(".arrow");
                 arrow.textContent = expanded ? "▶" : "▼";

                 // Show/hide all following siblings that have class 'tree-children'
                 let sibling = this.nextElementSibling;
                 while (sibling && sibling.classList.contains("tree-children")) {
                     sibling.style.display = expanded ? "none" : "block";
                     sibling = sibling.nextElementSibling;
                 }
             });
         });
    });

</script>

<script>

        function filterSidenav() {
        const input = document.getElementById("sidenavSearch");
        const filter = input.value.trim().toLowerCase();
        const allNavItems = document.querySelectorAll("#mySidenav .tree-nav");

        // If search box is empty → collapse all trees and show all root items
        if (!filter) {
            allNavItems.forEach(nav => {
                const toggleButton = nav.querySelector(".tree-toggle");
                const treeChildren = nav.querySelectorAll(".tree-children");

                nav.style.display = ""; // show all root items
                treeChildren.forEach(child => (child.style.display = "none")); // hide all children

                if (toggleButton) {
                    toggleButton.setAttribute("aria-expanded", "false");
                    const arrow = toggleButton.querySelector(".arrow");
                    if (arrow) arrow.textContent = "▶";
                }
            });
            return;
        }

        // Otherwise, perform search filtering
        allNavItems.forEach(nav => {
            const flatLink = nav.querySelector(":scope > a"); // For flat links like 'Home'
            const toggleButton = nav.querySelector(".tree-toggle");
            const treeChildren = nav.querySelectorAll(".tree-children");
            let matchFound = false;

            // Case 1: Flat link
            if (flatLink) {
                const text = flatLink.textContent.toLowerCase();
                if (text.includes(filter)) {
                    nav.style.display = "";
                    matchFound = true;
                } else {
                    nav.style.display = "none";
                }
            }

            // Case 2: Tree group
            if (toggleButton && treeChildren.length > 0) {
                let anyChildVisible = false;

                treeChildren.forEach(child => {
                    const childLink = child.querySelector("a");
                    if (childLink && childLink.textContent.toLowerCase().includes(filter)) {
                        child.style.display = "block";
                        anyChildVisible = true;
                    } else {
                        child.style.display = "none";
                    }
                });

                if (anyChildVisible) {
                    nav.style.display = "";
                    toggleButton.setAttribute("aria-expanded", "true");
                    const arrow = toggleButton.querySelector(".arrow");
                    if (arrow) arrow.textContent = "▼";
                } else {
                    nav.style.display = "none";
                    toggleButton.setAttribute("aria-expanded", "false");
                    const arrow = toggleButton.querySelector(".arrow");
                    if (arrow) arrow.textContent = "▶";
                }
            }
        });
    }
</script>

<script>
    function updateDateTime() {
        const now = new Date();
        const options = {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit'
        };
        const formattedDateTime = now.toLocaleString('en-GB', options).replace(',', '');
        document.getElementById("currentDateTime").innerText = formattedDateTime;
    }

    // Initial call and interval setup
    updateDateTime();
    setInterval(updateDateTime, 1000);

</script>

<script>
    let isNavOpen = false;

    function toggleNav() {
        const sidenav = document.getElementById("mySidenav");
        const topstrip = document.getElementById("topstrip");
        if (!sidenav || !topstrip) return;

        if (isNavOpen) {
            sidenav.classList.remove("open");
            topstrip.style.marginLeft = "0";
        } else {
            sidenav.classList.add("open");
            topstrip.style.marginLeft = "270px";
        }
        isNavOpen = !isNavOpen;
    }

    function closeNav() {
        const sidenav = document.getElementById("mySidenav");
        const topstrip = document.getElementById("topstrip");
        sidenav.classList.remove("open");
        topstrip.style.marginLeft = "0";
        isNavOpen = false;
    }

    document.addEventListener("click", function (event) {
        const sidenav = document.getElementById("mySidenav");
        const toggle = document.getElementById("menuToggle");
        if (isNavOpen && !sidenav.contains(event.target) && !toggle.contains(event.target)) {
            closeNav();
        }
    });
</script>