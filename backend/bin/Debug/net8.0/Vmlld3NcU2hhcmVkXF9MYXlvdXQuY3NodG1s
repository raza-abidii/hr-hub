        .sidenav {
            height: 100%;
            width:0;
            position: fixed;
            z-index: 1000;
            top: 0;
            left: 0;
            background-color: #455A6E;
            overflow-x: hidden;
            padding-top: 60px;

            /* transition: 0.5s; */
            transform-origin: left center;
            transform: scaleX(0);
            transition: transform 0.5s cubic-bezier(0.77, 0, 0.175, 1);
        }

        .sidenav.open {
            width: 270px; /* same width as your JS */
            transform: scaleX(1);
        }
        .sidenav a {
            padding: 12px 8px 12px 42px;
            text-decoration: none;
            font-size: 11px;
            color: white;
            display: block;
            transition: 0.3s;
        }

        .sidenav a:hover {
