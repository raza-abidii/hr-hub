    <script>
          // Load theme from cookie on page load
        window.addEventListener('DOMContentLoaded', () => {
            // const theme = getCookie("AppTheme") || "light";
            // document.getElementById("theme-css").href = `@csspath/css/theme-${theme}.css`;
            // document.getElementById("theme-selector").value = theme;
        });

        // When user changes the theme from the dropdown
        // document.getElementById("theme-selector").addEventListener("change", function () {
        //     debugger;
        //     const selectedTheme = this.value;
        //         document.getElementById("theme-css").href = `@csspath/css/theme-${selectedTheme}.css`;
        //         setCookie("AppTheme", selectedTheme, 365);
        // });

        // Helper to set cookie
        function setCookie(name, value, days) {
            const d = new Date();
            d.setTime(d.getTime() + (days*24*60*60*1000));
            document.cookie = `${name}=${value};expires=${d.toUTCString()};path=/`;
        }

        // Helper to get cookie
        function getCookie(name) {
            const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
            return match ? match[2] : null;
        }
    </script>


    @* Separate Form to change Password *@
    <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="background:lightslategray;color:white">
                <form asp-action="ChangePassword" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="changePasswordModalLabel">Change Password</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="OldPassword" class="form-label">Old Password</label>
                            <input type="password" name="OldPassword" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label for="NewPassword" class="form-label">New Password</label>
                            <input type="password" name="NewPassword" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label for="ConfirmPassword" class="form-label">Confirm New Password</label>
                            <input type="password" name="ConfirmPassword" class="form-control" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div aria-live="polite" aria-atomic="true" class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
        <div class="toast align-items-center text-white bg-@TempData["ToastType"] border-0" role="alert" id="toastMessage" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    @TempData["ToastMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
