        debugger;
            $('table tbody').on('keydown', 'input', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();

            var $table = $(this).closest('table');
            var tableId = $table.attr('id'); // Get table ID dynamically
            var $lastRow = $table.find('tbody tr:last');

            if ($(this).closest('tr').is($lastRow)) {
                var $newRow = $('<tr><td><input type="text" class="form-control" /></td></tr>');
                $table.find('tbody').append($newRow);
                $newRow.find('input').focus(); // Focus new input
            }

            // Optional: use tableId if you want to do something table-specific
            console.log("Entered in table: " + tableId);
        }
    });

    });

    //on button save send earning table data and deduction table data to controller

    $('#tbnSave').click(function () {
        debugger;
        var earnings = [];
        $('#tblearning tbody tr').each(function () {
            var earning = $(this).find('input').val();
            if (earning) {
                earnings.push(earning);
            }
        });
        var deductions = [];
        $('#tbldeduction tbody tr').each(function () {
            var deduction = $(this).find('input').val();
            if (deduction) {
                deductions.push(deduction);
            }
        });
        var requestData={ earnings: earnings, deductions: deductions }
        // Send data to controller via AJAX
        $.ajax({
            url: '@Url.Action("SaveSalaryDetails", "Salary")',
            type: 'POST',
            data: requestData,

            success: function (response) {
                debugger;
                alert('Salary details saved successfully!');
            },
            error: function (xhr, status, error) {
                alert('Error saving salary details: ' + error);
            }
        });
    });

</script>