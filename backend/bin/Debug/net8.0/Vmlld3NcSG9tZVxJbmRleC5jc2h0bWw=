<script>
    const ctx = document.getElementById('attendancePieChart').getContext('2d');

    const total = @ViewBag.empCount ?? 0;
    const present = @ViewBag.empPresentCount ?? 0;
    const absent = total - present;

    const presentPercentage = total > 0 ? `${(present / total * 100).toFixed(0)}%` : '0%';
    const absentPercentage = total > 0 ? `${(absent / total * 100).toFixed(0)}%` : '0%';

    // Plugin registration
    Chart.register(ChartDataLabels);

    if (ctx) {
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Absent', 'Present'],
                datasets: [{
                    data: [absent, present],
                    backgroundColor: ['#bd3f3f', '#589d86'],
                    borderColor: '#fff',
                    borderWidth: 2
                }]
            },
            options: {
                plugins: {
                    legend: {
                        display: true,
                        position: 'bottom',
                        labels: {
                            usePointStyle: true,
                            pointStyle: 'circle',
                            boxWidth: 10,
                            font: {
                                size: 12
                            }
                        }
                    },
                    title: {
                        display: true,
                        text: 'Employee Attendance',
                        font: {
                            weight: 'bold'
                        }
                    },
                    datalabels: {
                        color: '#fff',
                        font: {
                            weight: 'bold',
                            size: 14
                        },
                        formatter: function(value, context) {
                            const index = context.dataIndex;
                            return index === 0 ? absentPercentage : presentPercentage;
                        }
                    }
                }
            },
            plugins: [ChartDataLabels]
        });
    }
</script>

