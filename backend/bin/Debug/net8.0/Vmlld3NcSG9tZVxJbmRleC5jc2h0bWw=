@* Toast Message to show the error for Password Change *@
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
        //debugger;
        // Show toast if message exists
        var toastEl = document.getElementById('toastMessage');
        if (toastEl && toastEl.innerText.trim() !== "") {
        var toast = new bootstrap.Toast(toastEl);
        toast.show();

        }

        // Show Change Password Modal if flag is set
        var shouldShowModal = '@TempData["ShowChangePasswordModal"]';
        if (shouldShowModal === 'true') {
        var modal = new bootstrap.Modal(document.getElementById('changePasswordModal'));
        modal.show();
        }
        });
    </script>
}



