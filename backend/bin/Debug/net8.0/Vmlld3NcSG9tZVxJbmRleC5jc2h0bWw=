                                                    cellClass += " bg-holiday";
                                                }
                                                else if (remark.Contains("Absent"))
                                                {
                                                    cellClass += " bg-absent";
                                                }
                                                else if (remark.Contains("Late In"))
                                                {
                                                    cellClass += " bg-late";

                                                }
                                                else if (remark.Contains("On Time"))
                                                {
                                                    cellClass += " bg-present";
                                                }
