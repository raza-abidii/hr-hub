        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        transition: 0.3s;
    }

    .card-item {
        flex: 0 0 calc((100% - 3 * 1.9rem) / 3); /* 3 cards per row */
        max-width: calc((100% - 3 * 1.9rem) / 3);
    }

    @@media (max-width: 992px) {
        .card-item {
