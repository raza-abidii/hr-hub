<script>
    debugger;
    // Get login time string from the ViewBag element
    const loginTimeStr = document.getElementById("loginTime").textContent.trim();
      // Combine today's date with the login time (HH:mm:ss)
    const today = new Date();
    const [hours, minutes, seconds] = loginTimeStr.split(":").map(Number);
    const loginTime = new Date(today.getFullYear(), today.getMonth(), today.getDate(), hours, minutes, seconds);

      function formatTime(h, m, s) {
      return (
        String(h).padStart(2, '0') + ":" +
        String(m).padStart(2, '0') + ":" +
        String(s).padStart(2, '0')
      );
    }

    function updateWorkClock() {
      const now = new Date();
      const diff = now - loginTime;
      if (diff < 0) return; // Prevent negative time in case of clock mismatch

      const totalSeconds = Math.floor(diff / 1000);
      const hrs = Math.floor(totalSeconds / 3600);
      const mins = Math.floor((totalSeconds % 3600) / 60);
      const secs = totalSeconds % 60;

      document.getElementById("workClock").textContent = formatTime(hrs, mins, secs);
    }


    setInterval(updateWorkClock, 1000);
    updateWorkClock();
</script>

<script>
    const statusDiv = document.getElementById("punchStatus");

    async function sendPunch(type, lat, lon) {
        try {
            const response = await fetch(`/Attendance/Punch?type=${type}&lat=${lat}&lon=${lon}`, {
                method: "POST"
            });
            const result = await response.text();
            statusDiv.innerHTML = result;
        } catch (err) {
            statusDiv.innerHTML = "⚠️ Server error while punching.";
        }
    }

    function getLocationAndPunch(type) {
        if (!navigator.geolocation) {
            statusDiv.innerHTML = "Geolocation not supported by your browser.";
            return;
        }

        statusDiv.innerHTML = "📍 Getting your location...";
        navigator.geolocation.getCurrentPosition(
            (position) => {
                const lat = position.coords.latitude;
                const lon = position.coords.longitude;
                sendPunch(type, lat, lon);
            },
            (error) => {
                statusDiv.innerHTML = "❌ Please allow location access to punch attendance.";
            }
        );
    }

    document.getElementById("btnLoginPunch").addEventListener("click", () => getLocationAndPunch("login"));
    document.getElementById("btnLogoutPunch").addEventListener("click", () => getLocationAndPunch("logout"));
</script>