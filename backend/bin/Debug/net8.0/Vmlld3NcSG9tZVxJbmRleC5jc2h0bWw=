<script>

       function exportExcel(title, excelfile) {
            debugger;
            var table = document.getElementById(excelfile.substring(1));
            var tbody = table.querySelector("tbody");
            var rows = tbody.querySelectorAll("tr");

            if (rows.length > 0 && !(rows.length === 1 && rows[0].innerText.includes("No data found"))) {
                var wb = XLSX.utils.table_to_book(table, { sheet: title });
                var ws = wb.Sheets[title];

                // 🔹 Auto-fit column widths
                var colWidths = [];
                var data = XLSX.utils.sheet_to_json(ws, { header: 1 });
                data.forEach(row => {
                    row.forEach((cell, i) => {
                        let cellValue = cell ? cell.toString() : "";
                        colWidths[i] = Math.max(colWidths[i] || 10, cellValue.length + 2);
                    });
                });
                ws['!cols'] = colWidths.map(w => ({ wch: w }));

                // 🔹 Company Name (Row 1)
                var companyName = '@companyName';
                XLSX.utils.sheet_add_aoa(ws, [[companyName]], { origin: "A1" });

                // 🔹 Report Title (Row 2)
                XLSX.utils.sheet_add_aoa(ws, [[title]], { origin: "A2" });

                // Add Date
                // Get current date
                var today = new Date();
                var formattedDate = today.toLocaleDateString("en-GB");
                XLSX.utils.sheet_add_aoa(ws, [[formattedDate]], { origin: "A3" });

                // 🔹 Push down existing data by 2 rows
                XLSX.utils.sheet_add_aoa(ws, data, { origin: "A4" });

                // 🔹 Merge Row 1 and Row 2 across all columns
                var lastCol = colWidths.length - 1;
                ws['!merges'] = ws['!merges'] || [];
                ws['!merges'].push(
                    { s: { r: 0, c: 0 }, e: { r: 0, c: lastCol } }, // Row 1
                    { s: { r: 1, c: 0 }, e: { r: 1, c: lastCol } },  // Row 2
                    { s: { r: 2, c: 0 }, e: { r: 2, c: lastCol } }  // Row 3
                );

                // 🔹 Style rows (requires xlsx-style / pro build)
                if (!ws['A1'].s) ws['A1'].s = {};
                ws['A1'].s = { font: { bold: true, sz: 16 }, alignment: { horizontal: "center", vertical: "center"  } };
                if (!ws['A2'].s) ws['A2'].s = {};
                ws['A2'].s = { font: { bold: true, sz: 14 }, alignment: { horizontal: "center", vertical: "center"  } };
                if (!ws['A3'].s) ws['A3'].s = {};
                ws['A3'].s = { font: { bold: true, sz: 14 }, alignment: { horizontal: "center", vertical: "center"  } };

                ws['A4'].s = { font: { bold: true, sz: 14 } };

                // 🔹 Add company logo in header (works in Page Layout / print view)
               @*  var companyLogo = '@Html.Raw(companyLogo)'; // should be Base64 "data:image/png;base64,..."
            
                ws['!headerFooter'] = {
                    oddHeader: "&C&[Picture]",   // &C = Center, &[Picture] = placeholder
                    images: {
                        "logo": { path: companyLogo, type: "png", position: { type: "header", location: "center" } }
                    }
                }; *@

                XLSX.writeFile(wb, excelfile.substring(1) + ".xlsx");
            } else {
            alert("No employee data available to export!");
        }
    }
