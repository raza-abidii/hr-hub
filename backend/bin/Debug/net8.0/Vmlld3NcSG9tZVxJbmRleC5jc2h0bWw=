<script>
    const canvas = document.getElementById("analogClock");
    const ctxa = canvas.getContext("2d");
    const radius = canvas.height / 2;
    ctxa.translate(radius, radius); // center
    const clockRadius = radius * 0.90;

    function drawClock() {
        drawFace(ctxa, clockRadius);
        drawNumbers(ctxa, clockRadius);
        drawTime(ctxa, clockRadius);
    }

    function drawFace(ctxa, radius) {
        ctxa.beginPath();
        ctxa.arc(0, 0, radius, 0, 2 * Math.PI);
        ctxa.fillStyle = 'white';
        ctxa.fill();

        // Outer border
        ctxa.strokeStyle = '#333';
        ctxa.lineWidth = radius * 0.05;
        ctxa.stroke();

        // Center dot
        ctxa.beginPath();
        ctxa.arc(0, 0, radius * 0.05, 0, 2 * Math.PI);
        ctxa.fillStyle = '#333';
        ctxa.fill();
    }

    function drawNumbers(ctxa, radius) {
        ctxa.font = radius * 0.15 + "px Arial";
        ctxa.textBaseline = "middle";
        ctxa.textAlign = "center";
        for (let num = 1; num <= 12; num++) {
            const ang = num * Math.PI / 6;
            ctxa.rotate(ang);
            ctxa.translate(0, -radius * 0.85);
            ctxa.rotate(-ang);
            ctxa.fillText(num.toString(), 0, 0);
            ctxa.rotate(ang);
            ctxa.translate(0, radius * 0.85);
            ctxa.rotate(-ang);
        }
    }

    function drawTime(ctxa, radius) {
        const now = new Date();
        const hour = now.getHours() % 12;
        const minute = now.getMinutes();
        const second = now.getSeconds();

        // Hour hand
        drawHand(ctxa, (hour + minute / 60) * 30 * Math.PI / 180, radius * 0.5, radius * 0.07);
        // Minute hand
        drawHand(ctxa, (minute + second / 60) * 6 * Math.PI / 180, radius * 0.8, radius * 0.05);
        // Second hand
        drawHand(ctxa, second * 6 * Math.PI / 180, radius * 0.9, radius * 0.02, 'red');
    }

    function drawHand(ctxa, pos, length, width, color = '#333') {
        ctxa.beginPath();
        ctxa.lineWidth = width;
        ctxa.lineCap = "round";
        ctxa.strokeStyle = color;
        ctxa.moveTo(0,0);
        ctxa.rotate(pos);
        ctxa.lineTo(0, -length);
        ctxa.stroke();
        ctxa.rotate(-pos);
    }

    setInterval(drawClock, 1000);
    drawClock(); // initial draw
</script>

