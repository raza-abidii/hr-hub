@model List<EMSSolution.Models.Employee>
<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New Employee</title>
    <link rel="stylesheet" href="~/css/Style.css">
    <style>
        .container {
            background: #fff;
            padding: 20px;
            max-width: 800px;
            margin: 30px auto;
            border-radius: 8px;
            border: 1px solid #ccc;
        }

        .containerimage {
            background: #fff;
            padding: 60px;
            max-width: 160px;
            margin: 0px auto;
            border-radius: 8px;
            border: 1px solid #ccc;
        }

        h2 {
            text-align: center;
        }

        .tabs {
            display: flex;
            border-bottom: 2px solid #ddd;
            background: #8c8787;
            padding: 0 10px;
            gap: 10px;
        }

            .tabs button {
                background: none;
                border: none;
                padding: -1px 20px;
                cursor: pointer;
                font-weight: 600;
                color: #555;
                border-bottom: 3px solid transparent;
                transition: all 0.3s ease;
                font-size: 16px;
            }

                .tabs button.active {
                    color: #fff;
                    border-bottom: 3px solid #007bff;
                    background-color: #151414;
                }

        .tab-button:hover {
            color: #fff;
        }

        .tab-content {
            display: none;
        }

            .tab-content.active {
                display: block;
            }


        .form-row {
            display: flex;
            margin-bottom: 10px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2px 20px;
        }

        .form-group {
            flex: 1;
            padding-right: 20px;
        }

            .form-group label {
                display: block;
                margin-bottom: 5px;
            }

            .form-group input, .form-group select {
                width: 100%;
                padding: 5px;
            }

                .form-group input[type="radio"],
                .form-group input[type="checkbox"] {
                    width: auto;
                    margin-right: 5px;
                }

        .checkbox-group {
            display: flex;
            flex-wrap: wrap;
        }

            .checkbox-group label {
                margin-right: 20px;
            }

        .form-actions {
            text-align: right;
            margin-top: 20px;
        }

            .form-actions button {
                padding: 8px 20px;
                margin-left: 10px;
            }

        .radio-inline-group {
            display: flex;
            align-items: center;
            gap: 20px;
        }

            .radio-inline-group label {
                font-weight: 600;
                white-space: nowrap;
            }

        .radio-group {
            display: flex;
            gap: 15px;
        }

        .radio-item {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .flex {
            display: flex;
            gap: 16px;
        }

        /*   body {
                                                    background-color: #cccccc;
                                                } */

        input:invalid {
            border: 2px solid red;
        }

        @@media (max-width: 600px) {
            .tabs {
                flex-direction: column;
                align-items: stretch;
            }

            .tab-button {
                width: 100%;
                text-align: left;
                border-left: 3px solid transparent;
                border-bottom: none;
            }

                .tab-button.active {
                    border-left: 3px solid #007bff;
                    border-bottom: none;
                }
        }
    </style>
</head>
<body>

    <div class="container">
        <h4 class="text-center d-flex justify-content-center align-items-center gap-2">
            Add New Employee
            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 48 48">
                <circle cx="24" cy="14" r="10" fill="#4A90E2" /> <!-- Head -->
                <path d="M8 42c0-8.84 7.16-16 16-16s16 7.16 16 16v2H8v-2z" fill="#50E3C2" /> <!-- Body -->
            </svg>

        </h4>

        <div class="tabs">
            <button class="tab-button active" onclick="openTab('company')">Company Details</button>
            <button class="tab-button" onclick="openTab('personal')">Personal Details</button>
            <button class="tab-button" onclick="openTab('bankDetails')">Bank Details</button>
            <button class="tab-button" onclick="openTab('LeaveAllocation')">Leave Alocation</button>
        </div>

        <!-- Company Details Tab -->
        <div id="company" class="tab-content active">
