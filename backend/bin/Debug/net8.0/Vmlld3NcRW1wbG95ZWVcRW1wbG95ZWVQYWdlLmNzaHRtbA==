                        {
                            <tr>
                                <td>
                                    <input type="checkbox" name="selectedLeaves" value="@item.iMasterid" />
                                </td>
                                <td>@item.sLeaveType</td>
                                <td>
                                    <input type="number" name="permonth" id="permonth" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-3">
            <div class="flex">
                <button id="btnsummit" type="submit" class="btn btn-outline-primary" style="width:155px" accesskey="s">Save</button>
                <button id="btnrefresh" type="button" class="btn btn-outline-primary" style="width:155px" accesskey="r">Refresh</button>
                <button id="btnDelete" type="button" class="btn btn-outline-primary" style="width:120px" accesskey="l">Delete</button>
            </div>
        </div>
    </div>

    <div class="container">
        <div style="display: flex; justify-content: flex-end; margin-bottom: 10px;">
            <input type="text" id="searchBox" class="col-4 display: flex margin-right" placeholder="Search..." onkeyup="searchTable()" />
        </div>

        <div class="table-responsive">
            <table id="myTable" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th> Sno</th>
                        <th> Employee Code</th>
                        <th> Employee Name</th>
                        <th hidden> Masterid</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var intRow = 1;

                        foreach (var entry in Model)
                        {

                            <tr>
                                <td>@intRow</td>
                                <td>@entry.sEmployeeCode</td>
                                <td>@entry.sEmployeeName</td>
                                <td hidden>@entry.iMasterid</td>
                            </tr>
                            intRow = intRow + 1;
                        }
                    }
                </tbody>
            </table>
        </div>

    </div>
</body>
</html>


