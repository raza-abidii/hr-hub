            </div>

            <input type="file" id="photoInput" name="photo" accept="image/*" style="display: none;">
            @*  <button id="selectButton" style="margin-left:300px">Select Photo</button>
            <span id="fileNameDisplay"></span> *@
            <div class="text-center mb-3">
                <button id="selectButton" class="btn btn-primary">Select Photo</button>
                <button type="button" id="removePhotoButton" class="btn btn-danger ms-2">Remove Photo</button>
            </div>
            <span id="fileNameDisplay"></span>

            <div class="form-row">



                <div class="form-group">
                    <label for="employeeCode">Emp Code/Emp Id/Bio Id <span style="color:red">*</span></label>
                    <input asp type="text" id="employeeCode" name="employeeCode">
                </div>

                <div class="form-group">
                    <label for="employeeName">Employee Name <span style="color:red">*</span></label>
                    <input type="text" id="employeeName" name="employeeName">
                </div>

                <div class="form-group">
                    <label for="hireDate">Hire Date:</label>
                    <input type="date" id="hireDate" name="hireDate">
                </div>

            </div>
            @* <br /> *@
            <div class="form-row">


                <div class="form-group">
                    <label for="gender">Gender:</label>
                    <select id="gender" name="gender">
                        <option value="">Select</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Female">Others</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="category">Category:</label>
                    <select id="category" name="category" class="form-control">
                        <option value="">Select</option>
                        @foreach (var item in ViewBag.Categories)
                        {
                            <option value="@item.iMasterid">@item.sName</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="branch">Branch<span style="color:red">*</span></label>
                    <select id="branch" name="branch" class="form-control">
                        <option value="">Select</option>
                        @foreach (var item in ViewBag.branches)
                        {
                            <option value="@item.iMasterid">@item.sName</option>
                        }
                    </select>
                </div>

            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="designation">Designation:</label>
                    <select id="designation" name="designation">
                        <option value="">Select</option>
                        @foreach (var item in ViewBag.Designations)
                        {
                            <option value="@item.iMasterid">@item.sName</option>
                        }

                    </select>
                </div>

                <div class="form-group">
                    <label for="department">Department:</label>
                    <select id="department" name="department">
                        <option value="">Select</option>
                        @foreach (var item in ViewBag.Departments)
                        {
                            <option value="@item.iMasterid">@item.sName</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="shiftName">Shift Name:</label>
                    <select id="shiftName" name="shiftName">
                        <option value="">Select</option>
                        @foreach (var item in ViewBag.Shifts)
                        {
                            <option value="@item.iMasterid">@item.sShiftName</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-row">


                <div class="form-group">
                    <label for="pan">Pan No:</label>
                    <input type="text" id="pan" name="pan" oninput="limitInput(this,10)">
                </div>
                <div class="form-group">
                    <label for="aadhar">Aadhar No:</label>
                    <input type="number" id="aadhar" name="aadhar" oninput="limitInput(this,12)">
                </div>

                <div class="form-group">
                    <label for="passport">Passport No:</label>
                    <input type="text" id="passport" name="passport" oninput="limitInput(this,16)">
                </div>
            </div>

            <div class="form-row">


