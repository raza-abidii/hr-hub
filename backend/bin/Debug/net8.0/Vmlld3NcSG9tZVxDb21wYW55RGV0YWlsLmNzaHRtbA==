@{
    ViewBag.Title = "Company Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/Style.css">
    <style>
        .photo-box {
            width: 120px;
            height: 120px;
            border: 2px dashed #ccc;
            border-radius: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            margin: 20px auto;
            background-color: #f9f9f9;
        }
        #photoPreview {
            display: none;
            max-width: 100%;
            max-height: 100%;
        }


    </style>
    
</head>
<body>
    <div class="container">
        <h4 class="text-center d-flex justify-content-center align-items-center gap-2">
            
            Company Detail 
            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 64 64">
                <rect x="8" y="24" width="16" height="32" fill="#aed581" />
                <rect x="24" y="16" width="16" height="40" fill="#81c784" />
                <rect x="40" y="28" width="16" height="28" fill="#4caf50" />
                <rect x="12" y="36" width="4" height="4" fill="#33691e" />
                <rect x="28" y="24" width="4" height="4" fill="#33691e" />
                <rect x="44" y="36" width="4" height="4" fill="#33691e" />
            </svg>
        </h4>
        <div class="form-group mb-3">
            <label for="CompanyName" class="form-label">Company Name <span style="color: red;">*</span></label>
            <input type="text" class="form-control" id="CompanyName" name="CompanyName" required />
        </div>

        <div class="form-group mb-3">
            <label for="Address" class="form-label">Address<span style="color: red;">*</span></label>
            <textarea class="form-control" style="font-size:12px" id="Address" name="Address" rows="3" required></textarea>
        </div>

        <div class="form-group mb-3">
            <label for="City" class="form-label">City<span style="color: red;">*</span></label>
            <input type="text" class="form-control" id="City" name="City" required />
        </div>

        <div class="form-group mb-3">
            <label for="Landmark" class="form-label">Landmark</label>
            <input type="text" class="form-control" id="Landmark" name="Landmark" />
        </div>

        <div class="form-group mb-3">
            <label for="MonthStartfrom" class="form-label">Month Start Day<span style="color: red;">*</span></label>
            <select id="MonthStartfrom" name="MonthStartfrom" class="form-control">
                <option value="">-- Select Month Start --</option>
                @for (int i = 1; i <= 31; i++)
                {
                    <option value="@i">@i</option>
                }
            </select>

        </div>
              
        @* <div style="width: 100px; height: 100px; border: 2px dashed #ccc; display: flex; justify-content: center; align-items: center; overflow: hidden; margin: 20px auto;">
            <img id="photoPreview" src="#" alt="Photo Preview" style="display:none; max-width:100px; max-height:100px;" />
        </div> *@
        <div class="photo-box">
            <img id="photoPreview" src="#" alt="Photo Preview" />
        </div>

        <input type="file" id="photoInput" name="photo" accept="image/*" style="display: none;">
      
        <div class="text-center mb-3">
            <button id="selectButton" class="btn btn-outline-primary ">Select Photo</button>
            <button type="button" id="removePhotoButton" class="btn btn-danger ms-2 ">Remove Photo</button>
        </div>
        <span id="fileNameDisplay"></span>

        <div class="form-group mb-3">
            <button type="button" id="btnSave" name="brnSave" class="btn btn-outline-primary ">Save</button>
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary ">Cancel</a>
        </div>
    </div>
</body>

</html>

<script>
    $(document).ready(function () {
        debugger;
        $.ajax({
            url: '@Url.Action("GetCompany", "Company")',

            success: function (response) {
                if (response.status == true) {
                    setCompany(response.data);
                }
                else {
                    alert(response.message);
                }
            },
            error: function (e) {
                debugger;
            }
        });
    });

    function setCompany(data)
    {
        debugger;
        $('#CompanyName').val(data.companyName);
        $('#Address').val(data.address);
        $('#City').val(data.city);
        $('#Landmark').val(data.landmark);
        $('#MonthStartfrom').val(data.monthStartfrom);
        $('#photoPreview').attr('src', data.logo)
        $('#photoPreview').show();
    }
</script>

<script>
    $('#removePhotoButton').on('click', function () {
        $('#photoPreview').attr('src', '#').hide();
        $('#photoInput').val('');
    });

    $('#selectButton').on('click', function() {
        debugger;
        $('#photoInput').click(); // trigger file input click
    });

    $('#photoInput').on('change', function() {
        debugger
        const file = this.files[0];
        if (file) {
            const fileName = file.name;
            const imageUrl = URL.createObjectURL(file);
            $('#photoPreview').attr('src', imageUrl).show();
        }
    });

     $('#btnSave').click(function (e) {
         debugger;
         var companyname = $('#CompanyName').val();
         var address = $('#Address').val();
         var city = $('#City').val();
         var landmark = $('#Landmark').val();
         var monthStartfrom = $('#MonthStartfrom').val();
         var imgdata= getImageBase64();
         var logo = imgdata ? imgdata : 'data:,'; // Get Base64 image data or null if no image
         var companyDetail =JSON.stringify({
            Id:0,
            CompanyName: companyname,
            Address: address,
            City: city,
            Landmark: landmark,
            MonthStartfrom: monthStartfrom,
            Logo: logo // Include the Base64 image data
         });

        $.ajax({
            type: "POST",
            url: '@Url.Action("SaveCompany", "Company")', // Adjust the URL to your action method
            data: companyDetail,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                if (response.status) {
                    alert(response.message);
                    window.location.href = '@Url.Action("Index", "Home")'; // Redirect to index page
                } else {
                    alert(response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("Error occurred:", error);
                alert("An error occurred while saving company details.");
            }
        });
     });


     function getImageBase64() {
        const img = document.getElementById('photoPreview');

        //Check if the image has a valid source
        if (img.src &&
            (img.src !== "#" && img.getAttribute("src")!== "#" && img.getAttribute("src")!=="data:,")
            && img.complete) {
            const canvas = document.createElement('canvas');
            canvas.width = img.naturalWidth;
            canvas.height = img.naturalHeight;

            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0);

            // Convert canvas image to Base64
            const base64String = canvas.toDataURL('image/png'); // can use 'image/jpeg' too
            console.log(base64String);
            return base64String;
        } else {
            console.log("No valid image loaded yet.");
            return null;
        }
    }

</script>