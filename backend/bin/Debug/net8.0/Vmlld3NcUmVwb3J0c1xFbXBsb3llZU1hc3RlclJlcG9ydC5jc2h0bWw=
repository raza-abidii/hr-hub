                    <th>Employee Code</th>
                    <th>Branch</th>
                    <th>Category</th>
                    <th>Department</th>
                    <th>Designation</th>
                    <th>Mobile No</th>
                    <th>Email Address</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200" id="tableBody">
                @*   <tr>
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">XXX</td>
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">ZZZ</td>
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">BBB</td>
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">BBB</td>
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">BBB</td>
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">BBB</td>
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">BBB</td>
                    <td class="px-2 py-1 whitespace-nowrap border-r border-gray-100">BBB</td>
                </tr> *@
            </tbody>
        </table>
    </div>

</body>
</html>

<script>
    $(document).ready(function() {

        $('#branch').select2({
            placeholder: "Select Branch",
            allowClear: true
        });
        $('#employee').select2({
            placeholder: "Select Employee",
            allowClear: true
        });

        focusonselectcontrol("#branch");
        focusonselectcontrol("#employee");


        $('#loader-overlay').hide();

     });
</script>
<script>
    $('#btnDisplay').click(function () {
        var employee = $('#employee').val();
        var branch = $('#branch').val();
        var $tbody = $('#tableBody');
        $('#loader-overlay').show();
        debugger;
        $.ajax({
            url: '@Url.Action("GetEmployeesReport", "EmployeeMasterReport")',
            type: 'GET',
            data: {
                employeeId: employee,
                branchId: branch
            },
            success: function (reponse) {
                if(reponse.success==false){
                    alert(reponse.message);
                    $('#loader-overlay').hide();
                    return;
                }
                const data = reponse.data;
                $tbody.empty();
                if (data && data.length > 0) {
                    $.each(data, function (i, e) {
                        $tbody.append(`
                            <tr>
                                <td>${e.sEmployeeName}</td>
                                <td>${e.sEmployeeCode}</td>
                                <td>${e.branch}</td>
                                <td>${e.category}</td>
                                <td>${e.department}</td>
                                <td>${e.designation}</td>
                                <td>${e.mobileNo}</td>
                                <td>${e.emailId}</td>
                            </tr>
                        `);
                    });
                    $('#loader-overlay').hide();
                } else {
                    $tbody.append('<tr><td colspan="6" class="text-center">No records found</td></tr>');
                    $('#loader-overlay').hide();
                }
            },
            error: function () {
                $('#loader-overlay').hide();
                alert("Failed to load report.");
            }
        });

    });

    $('#clearFilters').on('click', function () {
         $('#employee').val('0').trigger('change'); // for select2
        $('#branch').val('0').trigger('change');   // for select2
    });

</script>
<script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>
<script>

        $('#exportexcel').click(function () {
        // Get table data
        var table = document.getElementById('myTable');
        var tableData = [];
        var headers = [];

        // Get headers
        $('#myTable thead tr th').each(function () {
            headers.push($(this).text().trim());
        });
        tableData.push(headers);

        // Get table rows
        $('#myTable tbody tr').each(function () {
            var row = [];
            $(this).find('td').each(function () {
                row.push($(this).text().trim());
            });
            tableData.push(row);
        });
        debugger;
        // Send to controller
        $.ajax({
            url: '@Url.Action("ExportToExcel", "EmployeeMasterReport")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ tableData: tableData }),
            xhrFields: {
                responseType: 'blob' // Important for binary Excel file
            },
            success: function (data, status, xhr) {
                debugger;
                // Get filename from response header
                  var disposition = xhr.getResponseHeader('Content-Disposition');
                    var matches = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/.exec(disposition);
                    var filename = (matches != null && matches[1]) ? matches[1].replace(/['"]/g, '') : "EmployeeMasterReport.xlsx";

                    // Create a link and download
                    var blob = new Blob([data], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                    var url = window.URL.createObjectURL(blob);

                    var a = document.createElement('a');
                    a.href = url;
                    a.download = filename;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    window.URL.revokeObjectURL(url);
                    $('#loader-overlay').hide();
            },
            error: function (err) {
                console.error(err);
            }
        });
    });
</script>

<script>

    function exportPdf(){
        debugger;
        var companyName = '@companyName';
            var companyLogo = '@Html.Raw(companyLogo)'; // Base64 string like "data:image/png;base64,...."
        var table = document.getElementById("myTable");
        var tbody = table.querySelector("tbody");
        var rows = tbody.querySelectorAll("tr");

        if (rows.length<=0) {
            alert("No data available to export!");
            return;
        }

        const { jsPDF } = window.jspdf;
        var doc = new jsPDF("l", "pt", "a4"); // landscape

        // Centered Logo
        const pageWidth = doc.internal.pageSize.getWidth();
        @* const imageWidth = 20;
        const imageHeight = 20;
        const x = (pageWidth - imageWidth) / 2;
        const y = 20;

        if (companyLogo) {
            doc.addImage(companyLogo, "PNG", x, y, imageWidth, imageHeight);
        } *@

        // Add company name
        doc.setFontSize(14);
        doc.text(companyName, pageWidth / 2, 50, { align: "center" });

        // Add PDF title
        doc.setFontSize(14);
        doc.text("Employees Detail", pageWidth / 2, 70, { align: "center" });


        // AutoTable
        doc.autoTable({
            html: "#myTable",
            startY: 100,
            styles: { fontSize: 8 },
            headStyles: { fontStyle: 'bold', fillColor: false, textColor: [0, 0, 0] } // remove bg, keep bold
        });

        doc.save("EmployeeDetail.pdf");
    }

</script>

<script>
    function searchTable(tableId, searchValue) {
        var value = searchValue.toLowerCase();
        var rows = document.querySelectorAll("#" + tableId + " tbody tr");

        rows.forEach(function (row) {
            var text = row.innerText.toLowerCase();
            row.style.display = text.includes(value) ? "" : "none";
        });
    }
</script>