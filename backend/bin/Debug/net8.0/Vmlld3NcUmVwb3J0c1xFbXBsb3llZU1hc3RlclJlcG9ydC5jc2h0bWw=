                <line x1="14" y1="28" x2="30" y2="28" stroke="#4a90e2" stroke-width="2" stroke-linecap="round" />
                <line x1="14" y1="36" x2="28" y2="36" stroke="#4a90e2" stroke-width="2" stroke-linecap="round" />

                <!-- Employee circle (head) -->
                <circle cx="48" cy="20" r="6" fill="#ffd17a" stroke="#d48806" stroke-width="2" />

                <!-- Employee body -->
                <path d="M40 34c0-4 4-6 8-6s8 2 8 6v4c0 2-4 4-8 4s-8-2-8-4v-4z" fill="#7ed6a5" stroke="#218c5f" stroke-width="2" />

                <!-- Small report badge -->
                <rect x="44" y="42" width="12" height="14" rx="2" ry="2" fill="#f2f2f2" stroke="#999" stroke-width="1.5" />
                <line x1="47" y1="47" x2="53" y2="47" stroke="#999" stroke-width="1.5" stroke-linecap="round" />
                <line x1="47" y1="51" x2="51" y2="51" stroke="#999" stroke-width="1.5" stroke-linecap="round" />
            </svg>
        </h4>



        <div class="d-flex gap-3 mb-3 align-items-end">
            <div class="form-group flex-fill">
                <label class="form-label">Employee</label>
                <select id="employee" class="form-select">
                    <option value="0">-- All Employees --</option>
                    @foreach (var employee in ViewBag.Employees)
                    {
                        <option value="@employee.iMasterid">@employee.sEmployeeName</option>
                    }
                </select>
            </div>

            <div class="form-group flex-fill justify-content-end">
                <label class="form-label">Branch</label>
                <select id="branch" class="form-select">
                    <option value="0">-- All Branches --</option>
                    @foreach (var branch in ViewBag.Branch)
                    {
                        <option value="@branch.iMasterid">@branch.sName</option>
                    }
                </select>
            </div>


        </div>

        <div class="d-flex gap-2 mb-3 justify-content-end">
            <button type="button" id="clearFilters" class="btn btn-secondary btn-custom">Clear</button>
            <button type="button" id="btnDisplay" class="btn btn-primary btn-custom">Display</button>
            <button id="exportexcel" type="button" class="btn btn-outline-primary btn-custom" accesskey="r">Excel</button>
            <button id="exportPDF" type="button" class="btn btn-outline-primary btn-custom" accesskey="d" onclick="exportPdf()">PDF</button>
        </div>
    </div>

    <div class="attendance-container overflow-x-auto p-4 bg-white shadow rounded-lg">

        <!-- Search box -->
        <div class="mb-3">
            <input type="text" class="form-control" placeholder="Search..."
