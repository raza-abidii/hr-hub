@model List<EMSSolution.Models.MachineMap>


<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/css/Style.css">

    <style>
        .flex {
            display: flex;
            gap: 16px;
        }
    </style>
</head>

<body>

    <div class="container" >
        <h4 class="text-center d-flex justify-content-center align-items-center gap-2">
            Machine Mapping
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- File -->
                <path d="M6 2H14L18 6V20C18 21.1 17.1 22 16 22H6C4.9 22 4 21.1 4 20V4C4 2.9 4.9 2 6 2Z"
                      fill="#E3F2FD" stroke="#1976D2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M14 2V6H18"
                      stroke="#1976D2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

                <!-- Location Pin -->
                <path d="M17 10C17 12.21 14 15 14 15C14 15 11 12.21 11 10C11 8.34 12.34 7 14 7C15.66 7 17 8.34 17 10Z"
                      fill="#FFEBEE" stroke="#D32F2F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="14" cy="10" r="1" fill="#D32F2F" />

                <!-- Mapping Line -->
                <line x1="14" y1="15" x2="14" y2="20"
                      stroke="#388E3C" stroke-width="2" stroke-linecap="round" />
                <circle cx="14" cy="20" r="1" fill="#388E3C" />
            </svg>


        </h4>
        <div asp-validation-summary="All" class="text-bg-danger"></div>
        <div class="form-group mb-3">

            <label for="IPAddress" class="form-label">IP Address</label>
            <input type="text" name="name" id="ipaddress" class="form-control" required placeholder="Enter IP Address like 127.0.0.1" />
            @* <span asp-validation-for="ipaddress" class="text-bg-danger"></span> *@
        </div>
        <div class="form-group mb-3">

            <label for="Desc" class="form-label">Description</label>
            <input type="text" name="description" id="description" class="form-control" placeholder="Enter Description of Machine" />
            @* <span asp-validation-for="description" class="text-bg-danger"></span> *@
        </div>
        <div class="form-group mb-3">
            <label for="machineid" class="form-label">Serial Number</label>
            <input type="text" name="name" id="MachineId" min="1" max="9999" class="form-control" placeholder="Enter Serial Number of Machine" />
        </div>
        <div class="form-group mb-3">
            <label for="ai" class="form-label">Active</label>
            <input type="checkbox" id="activeinactive" name="activeinactive" checked="checked" value="">
        </div>

        <div class="flex">
            <button id="btnsummit" type="submit" class="btn btn-outline-primary button-custom" accesskey="s">Save</button>
            <button id="btnrefresh" type="button" class="btn btn-outline-primary button-custom" accesskey="r">Refresh</button>
            <button id="btnDelete" type="button" class="btn btn-outline-primary button-custom" accesskey="l">Delete</button>
        </div>
    </div>

    <div class="container">
    <div style="display: flex; justify-content: flex-end; margin-bottom: 10px;">
        <input type="text" id="searchBox" class="col-4 display: flex margin-right" placeholder="Search..." onkeyup="searchTable()" />
    </div>

    <div class="table-responsive">
        <table id="myTable" class="table table-striped table-hover">
            <thead>
                <tr>
                    <th> Sno</th>
                    <th> Machine IP</th>
                    <th> Description</th>
                    <th> Machine Id</th>
                    <th> Active/Inactive</th>
                    <th> Created Date</th>
                    <th> Updated Date</th>
                    <th hidden> Masterid</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var intRow = 1;
                    var activeinactive = "";
                    foreach (var entry in Model)
                    {
                        if (@entry.IsActive == true)
                            activeinactive = "Active";
                        else
                            activeinactive = "In active";
                        <tr>
                            <td>@intRow</td>
                            <td>@entry.IPAddress</td>
                            <td>@entry.Description</td>
                            <td>@entry.MachineId</td>
                            <td>@activeinactive</td>
                            <td>@entry.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>@entry.UpdatedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td hidden>@entry.iMasterid</td>
                        </tr>
                        intRow = intRow + 1;
                    }
                }
            </tbody>
        </table>
    </div>
    </div>
</body>
</html>

<script src="~/js/GenericFunction.js"></script>
<script>
    var masterid=0;
    $(document).ready(function () {
        debugger;
        var iRowNo = 0;
        var currentRow;

        clearControl();
    });

    $('#btnrefresh').click(function (e) {
        debugger;
        clearControl();
    });
    $('#btnsummit').click(function (e) {
        debugger;
        let ipaddress =document.getElementById('ipaddress');
        ipaddress.value= ipaddress.value.trim();
        ipaddress.setCustomValidity('');

        if (!ipaddress.checkValidity()) {
            ipaddress.setCustomValidity('Please enter a IP Address');
            ipaddress.reportValidity();
            return;
        }

        var ip = $("#ipaddress").val();
        var ipPattern = /^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}$/;
        if (!ipPattern.test(ip)) {
            //alert("Please enter a valid IP address.");
            ipaddress.setCustomValidity('Please enter valid ip ipAddress [like 192.168.1.1]');
            ipaddress.reportValidity();
            return;
        }

        $('#loader').show();
        // if ($('#ipaddress').val() == '') {
        //     alert('Provide IP Address');
        //     $('#loader').hide();
        //     return;
        // }

        var ipAddress = $('#ipaddress').val();

        var MachineId = $('#MachineId').val();
        if ($('#MachineId').val() == '')
            MachineId = 1;

        var description = $('#description').val();
        if ($('#description').val() == '')
        description = '';

        var actInact = $('#activeinactive').is(":checked");
        var Masterid = masterid;

        const now = new Date();
        var dDate=now.toISOString();

        var requestdata=JSON.stringify({iMasterid:Masterid, IPAddress: ipAddress, MachineId: MachineId,
            Description: description, IsActive: actInact ,CreatedDate:dDate, UpdatedDate:dDate});
             // var requestdata=JSON.stringify({iMasterid:Masterid, IPAddress: ipAddress, MachineId: MachineId,
             //    Description: description, IsActive: actInact ,UpdatedDate:dDate});
        debugger;

        $.ajax
            ({
                url: '@Url.Action("SaveMachineMap", "MachineMap")',
                datatype: "json",
                type: "post",
                contentType: "application/json; charset=utf-8",
                cashe: true,
                data: requestdata,
                success: function (response) {
                    debugger;

                    if (response.status == true) {
                        updateTable(response.data, response.isNew)
                        alert(response.message);
                        $('#loader').hide();
                        clearControl();
                    }
                    else {
                        $('#loader').hide();
                        alert(response.message);
                    }
                },
                error: function (e) {
                    $('#loader').hide();
                    debugger;
                }
            })
    });
    $('#btnDelete').click(function (e) {
        debugger;
        if (masterid == 0) {
            alert('Select a row to delete');
            return;
        }
        var requestdata = { iMasterid: masterid };
        $.ajax
            ({
                url: '@Url.Action("DeleteMachineMap", "MachineMap")',
                datatype: "json",
                type: "post",
                cashe: true,
                data: requestdata,
                success: function (response) {
                    debugger;
                    if (response.status == true) {
                        alert(response.message);
                        $('#loader').hide();
                        location.reload();
                    }
                    else {
                        $('#loader').hide();
                        alert(response.message);
                    }
                },
                error: function (e) {
                    $('#loader').hide();
                    debugger;
                }
            })
    });

    $('body').on('click', 'tr', function () {
        debugger;
        var ipaddress = $(this).find("td").eq(1).html();
        var description = $(this).find("td").eq(2).html();
        var machineid = $(this).find("td").eq(3).html();
        var activeinactive = $(this).find("td").eq(4).html();

        masterid = $(this).find("td").eq(7).html();

        $('#ipaddress').val(ipaddress);
        $('#description').val(description);
        $('#MachineId').val(machineid);
        if (activeinactive == "Active")
            $("#activeinactive").prop("checked", true);
        else
            $("#activeinactive").prop("checked", false);
        iRowNo = $(this).closest("tr")[0].rowIndex;
        currentRow = $(this).closest("tr");

    });
    function clearControl() {
        $('#ipaddress').val('');
        $('#description').val('');
        $('#MachineId').val('');
        $("#activeinactive").prop("checked", true);
        masterid=0;
        $("#ipaddress").focus();
    }

    function updateTable(res, isNew) {
        debugger;
        if (isNew == 1) {

            var rowCount = $('#myTable tr').length;
            for (let i = 0; i < res.length; i++) {
                var date = new Date(res[i].createdDate)
                var dDatetime = date.toLocaleDateString() + ' ' + date.toLocaleTimeString();

                date = new Date(res[i].updatedDate);
                var dUpdatedDatetime =  date.toLocaleDateString() + ' ' + date.toLocaleTimeString();

                var isactive='';
                if(res[i].isActive==true)
                    isactive="Active";
                else
                    isactive="In active";

                $('#myTable').append('<tr>' +
                    '<td>' + (rowCount) + '</td>' +
                    '<td >' + res[i].ipAddress + '</td > ' +
                    '<td >' + res[i].description + '</td > ' +
                    '<td >' + res[i].machineId + '</td > ' +
                    '<td >' + isactive + '</td > ' +
                    '<td >' + dDatetime + '</td > ' +
                    '<td >' + dUpdatedDatetime + '</td > ' +
                    '<td style="display:none;">' + res[i].iMasterid + '</td > ' +
                    '</tr>');
            }
        }
        else {
            var date = new Date(res[0].createdDate)
            var dDatetime = date.toLocaleDateString().replace(/\//g, '-') + ' ' + date.toLocaleTimeString();

            date = new Date(res[0].updatedDate);
            var dUpdatedDatetime =  date.toLocaleDateString().replace(/\//g, '-') + ' ' + date.toLocaleTimeString();

            $("#myTable").val(currentRow.find("td:eq(1)").text(res[0].ipAddress));
            $("#myTable").val(currentRow.find("td:eq(2)").text(res[0].description));
            $("#myTable").val(currentRow.find("td:eq(3)").text(res[0].machineId));
            if(res[0].isActive==true)
                $("#myTable").val(currentRow.find("td:eq(4)").text("Active"));
            else
                $("#myTable").val(currentRow.find("td:eq(4)").text("In Active"));
            $("#myTable").val(currentRow.find("td:eq(5)").text(dDatetime));
            $("#myTable").val(currentRow.find("td:eq(6)").text(dUpdatedDatetime));
            $("#myTable").val(currentRow.find("td:eq(7)").text(res[0].iMasterid));
        }
    }
</script>