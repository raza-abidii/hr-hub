@model ShiftAllocationViewModel
@{
    ViewBag.Title = "Shift Allocation";
    var months = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.MonthNames;
}
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="~/css/Style.css">
    <style>
        .flex {
            display: flex;
            gap: 16px;
        }
        input:invalid {
            border: 2px solid red;
        }

        .bold-label {
            font-weight: bold;
        }
    </style>
</head>
<body>
   @*  <img id="loader" src="../Content/progress.gif" hidden="hidden" /> *@
    <div id="loader-overlay">
        <img src="../Content/progress.gif" class="loader-img" />
    </div>
    <div class="container">
       
        <h4 class="text-center d-flex justify-content-center align-items-center gap-2">
           
            Shift Allocation
            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke="#3B82F6" fill="#EFF6FF" />
                <path d="M16 2v4M8 2v4M3 10h18" stroke="#3B82F6" />
                <path d="M12 14l2 2-2 2m0-4l-2 2 2 2" stroke="#10B981" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </h4>
        <form id="shiftAllocationForm">
            <div class="form-group-2">
                <label class="bold-label">Allocation Type:</label><br />
                <label><input type="radio" name="AllocationType" value="EmployeeWise" checked onchange="toggleAllocationView()" /> Employee-wise</label>
                <label><input type="radio" name="AllocationType" value="CategoryWise" onchange="toggleAllocationView()" /> Category-wise</label>
            </div>
            <br />
            <div id="employeeDropdown" class="form-group">
                <label class="bold-label">Select Employee:</label>
                @Html.DropDownListFor(m => m.SelectedEmployeeId, Model.Employees, "-- Select Employee --", new { @class = "form-control" })

            </div>

            <div id="categoryDropdown" class="form-group" style="display: none;">
                <label class="bold-label">Select Category:</label>
                @Html.DropDownListFor(m => m.SelectedCategoryId, Model.Categories, "-- Select Category --", new { @class = "form-control" })
            </div>
            <br />
            <div class="form-group-2">
                <label class="bold-label">Time Frame:</label><br />
                <label><input type="radio" name="TimeFrameType" value="Monthly" checked onchange="toggleTimeView()" /> Monthly</label>
                <label><input type="radio" name="TimeFrameType" value="Yearly" onchange="toggleTimeView()" /> Yearly</label>
            </div>
            <br />
            <div id="monthlyOptions" class="form-row">
                <div class="form-group col-md-6">
                    <label class="bold-label">Month:</label>
                    <select id="monthDropdown" class="form-control" onchange="updateTable()">
                        @for (int i = 1; i <= 12; i++)
                        {
                            var selectedmonthName = (i == Model.SelectedMonth ? "selected" : "");
                            if (selectedmonthName == "")
                            {
                                <option value="@i">@months[i - 1]</option>
                            }
                            else
                            {
                                <option value="@i" selected>@months[i - 1]</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group col-md-6">
                    <label class="bold-label"   >Year:</label>
                    <select id="yearDropdown" class="form-control" onchange="updateTable()">
                        @for (int y = DateTime.Now.Year - 5; y <= DateTime.Now.Year + 5; y++)
                        {
                            var yearName = (y == Model.SelectedYear ? "selected" : "");
                            if (yearName == "")
                            {
                                <option value="@y">@y</option>
                            }
                            else
                            {
                                <option value="@y" selected>@y</option>
                            }

                        }
                    </select>
                </div>
            </div>

            <div id="yearlyOptions" class="form-group" style="display: none;">
                <label class="bold-label">Year:</label>
                <select id="yearOnlyDropdown" class="form-control">
                    @* @for (int y = DateTime.Now.Year - 5; y <= DateTime.Now.Year + 5; y++)
                    {
                        var yearName = (y == Model.SelectedYear ? "selected" : "");
                        <option value="@y @yearName">@y</option>
                    } *@
                    @for (int y = DateTime.Now.Year - 5; y <= DateTime.Now.Year + 5; y++)
                    {
                        var yearName = (y == Model.SelectedYear ? "selected" : "");
                        if (yearName == "")
                        {
                            <option value="@y">@y</option>
                        }
                        else
                        {
                            <option value="@y" selected>@y</option>
                        }

                    }
                </select>
            </div>

            <hr />

            <div class="form-group row">
                <label class="bold-label">Select Shift for All:</label>
                <div class="col-sm-4">
                    @Html.DropDownList("bulkShiftSelect", Model.Shifts, "-- Select Shift --", new { @class = "form-control", id = "bulkShiftSelect" })
                </div>
                <div class="col-sm-3">
                    <button type="button" class="btn btn-primary    " onclick="applyShiftToAll()">Apply to All</button>
                </div>
            </div>
            <br />
            <div id="monthlyTable">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Shift</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in Model.DaysInMonth)
                        {
                            <tr>
                                <td>@day</td>
                                <td>
                                    @Html.DropDownList("Shift_Day_" + day, Model.Shifts, "--", new { @class = "form-control" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="yearlyTable" style="display: none;">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Month</th>
                            <th>Shift</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var monthNames = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.MonthNames.Take(12).ToList();
                            int monthIndex = 1;
                        }
                        @foreach (var month in monthNames)
                        {
                            <tr>
                                <td>@month</td>
                                <td>
                                    @Html.DropDownList("Shift_Month_" + monthIndex, Model.Shifts, "--", new { @class = "form-control" })
                                </td>
                            </tr>
                            monthIndex++;
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-success" style="width:140px">Save</button>
            </div>

        </form>
        @* </div> *@
    </div>
</body>
</html>

<script src="/js/GenericFunction.js"></script>
<script>
     $(document).ready(function () {
        debugger;
         $('#SelectedEmployeeId').select2({
            placeholder: "Select employee",
            allowClear: true
        });
        focusonselectcontrol("#SelectedEmployeeId");
        
        $('#SelectedCategoryId').select2({
            placeholder: "Select Category",
            allowClear: true
        });
        focusonselectcontrol("#SelectedCategoryId");
        $('#SelectedEmployeeId').select2({ width: '100%' });
        $('#SelectedCategoryId').select2({ width: '100%' });

         $('#loader-overlay').hide();
     });

        var shiftOptionsHtml = `
        @foreach (var s in Model.Shifts)
        {
                    <text><option value="@s.Value">@s.Text</option></text>
        }
    `;

    $("#shiftAllocationForm").on("submit", function (e) {
        debugger;
        e.preventDefault();
         $('#loader-overlay').show();
        // Serialize form including selects in tables
        var formData = $(this).serialize();
        formData=formData + '&selectedmonth=' + $('#monthDropdown').val() + '&selectedyear=' + $('#yearDropdown').val();
        $.ajax({
            type: "POST",
            url: '@Url.Action("SaveShiftAllocation", "ShiftAllocation")',
            data: formData,
            success: function (response) {
                 $('#loader-overlay').hide();
                alert(response.message);

                // Optionally reload or redirect
            },
            error: function (xhr, status, error) {
                 $('#loader-overlay').hide();
                alert("An error occurred: " + error);

            }
        });
    });
    function toggleAllocationView() {
        const isEmployeeWise = document.querySelector('input[name="AllocationType"]:checked').value === "EmployeeWise";
        document.getElementById("employeeDropdown").style.display = isEmployeeWise ? "block" : "none";
        document.getElementById("categoryDropdown").style.display = isEmployeeWise ? "none" : "block";
       
    }

    function toggleTimeView() {
        const isMonthly = document.querySelector('input[name="TimeFrameType"]:checked').value === "Monthly";
        document.getElementById("monthlyOptions").style.display = isMonthly ? "flex" : "none";
        document.getElementById("yearlyOptions").style.display = isMonthly ? "none" : "block";
        document.getElementById("monthlyTable").style.display = isMonthly ? "block" : "none";
        document.getElementById("yearlyTable").style.display = isMonthly ? "none" : "block";
    }

    function updateTable() {
        // JS to update the table based on selected month/year
        debugger;
        var month = parseInt(document.getElementById("monthDropdown").value);
        var year = new Date().getFullYear();

        // JS trick: day 0 of next month = last day of current month
        var daysInMonth = new Date(year, month, 0).getDate();

        var tableBody = "";

        for (var day = 1; day <= daysInMonth; day++) {
            tableBody += `
                <tr>
                    <td>${day}</td>
                    <td>
                        <select class="form-control" name="Shift_Day_${day}">
                            <option value="">--</option>
                            <!-- You can inject shift options from Razor -->
                            ${shiftOptionsHtml}
                        </select>
                    </td>
                </tr>
            `;
        }

        document.querySelector("#monthlyTable tbody").innerHTML = tableBody;
    


    }

    
    
    

    document.addEventListener("DOMContentLoaded", function () {
        toggleAllocationView();
        toggleTimeView();
    });

    function applyShiftToAll() {
        debugger;
        const selectedShift = document.getElementById("bulkShiftSelect").value;
        if (!selectedShift) {
            alert("Please select a shift first.");
            return;
        }

        // Apply to monthly table
        document.querySelectorAll("#monthlyTable select").forEach(dropdown => {
            dropdown.value = selectedShift;
        });

        // Apply to yearly table
        document.querySelectorAll("#yearlyTable select").forEach(dropdown => {
            dropdown.value = selectedShift;
        });
    }
</script>
