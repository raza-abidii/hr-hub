    <script>

        const slides = [
            {
                iconPath: "M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h14a2 2 0 012 2v14a2 2 0 01-2 2zM9 9h6m-6 4h6m-6 4h6", // User group icon
                heading: "Welcome to EMS Solution!",
                paragraph: "Efficiently manage your workforce, streamline HR processes, and empower your team.",
                backgroundImage: "url('@imagePath1')"
            },
            {
                iconPath: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z", // Document/File icon
                heading: "Simplify Attendance Management",
                paragraph: "Access employee records, policies, and reports with ease.",
                backgroundImage: "url('@imagePath2')"
            },
            {
                iconPath: "M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z", // Chart/Analytics icon
                heading: "Gain Actionable Insights",
                paragraph: "Track key HR metrics and make data-driven decisions.",
                backgroundImage: "url('@imagePath3')"
            },
            {
                iconPath: "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z", // Calendar icon
                heading: "Manage Leave & Attendance",
                paragraph: "Effortlessly handle time-off requests and attendance tracking.",
                // backgroundImage: "url('image/4.jpg')"
                backgroundImage: "url('@imagePath4')"
            }
        ];

        let currentSlideIndex = 0;
        const slideIconPath = document.getElementById('slide-icon-path');
        const slideHeading = document.getElementById('slide-heading');
        const slideParagraph = document.getElementById('slide-paragraph');
        const slideElements = [slideIconPath, slideHeading, slideParagraph];


        function showSlide() {

            // Remove animation classes to allow re-triggering
            slideElements.forEach(el => {
                el.classList.remove('animate-fadeInSlideUp');
                // Force reflow
                void el.offsetWidth;
            });

            const slide = slides[currentSlideIndex];
            slideIconPath.setAttribute('d', slide.iconPath);
            slideHeading.textContent = slide.heading;
            slideParagraph.textContent = slide.paragraph;

            const slideBackground = document.getElementById('slide-background');
            slideBackground.style.backgroundImage = slide.backgroundImage;

            // Add animation classes
            slideElements.forEach(el => {
                el.classList.add('animate-fadeInSlideUp');
            });

            currentSlideIndex = (currentSlideIndex + 1) % slides.length;
        }

        // Show the first slide immediately
        showSlide();

        // Change slide every 5 seconds
        setInterval(showSlide, 3000);
    </script>

    <script>
        // Save selected company to localStorage when it changes
        document.addEventListener("DOMContentLoaded", function () {
            const companySelect = document.getElementById("Company");

            // Restore last selected company if available
            const savedCompany = localStorage.getItem("LastSelectedCompany");
            if (savedCompany) {
                companySelect.value = savedCompany;
            }

            // Save company when user changes it
            companySelect.addEventListener("change", function () {
                localStorage.setItem("LastSelectedCompany", this.value);
            });
        });
    </script>
</body>

