                </path>
            </svg>
            <h2 id="slide-heading" class="text-3xl font-bold mb-4">Welcome to HRM Central!</h2>
            <p id="slide-paragraph" class="text-lg opacity-90">Efficiently manage your workforce, streamline HR processes, and empower your team.</p>
        </div>

        <!-- Right Section -->
        @* <div class="md:w-1/2 p-8 md:p-12 flex flex-col justify-center"> *@
        <div class="md:w-2/5 p-8 md:p-12 flex flex-col justify-center">
            <button type="button"
                    onclick="openCreateCompany()"
                    class="relative absolute top-3 right-3 bg-indigo-500 hover:bg-indigo-600 text-white rounded-md p-2 shadow-md transition duration-200"
                    title="Create Company" style="width:50px;margin-left:263px;display:none">
                <i class="fa fa-plus"></i>
            </button>

            <h1 class="text-3xl font-extrabold text-gray-800 mb-6 text-center">Login</h1>

            <p class="text-gray-600 mb-8 text-center">Access your EMS Application.</p>

            <form action="#" method="POST" class="space-y-6">
                <!-- User Name -->
                <div>
                    <label for="UserName" class="block text-sm font-medium text-gray-700 mb-2">User Id</label>
                    <input type="text" id="UserName" name="UserName" required
                           style="height:30px;font-size:11px"
                           class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none input-focus transition duration-200"
                           placeholder="User Id">
                </div>

                <!-- Password -->
                <div class="relative">
                    <label for="password" class="block text-sm font-medium text-gray-700 mb-2">Password</label>
                    <input type="password" id="password" name="password" required
                           class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none input-focus transition duration-200"
                           style="height:30px;font-size:11px"
                           placeholder="Password">

                    <!-- Eye Icon -->
                    <span id="togglePassword"
                          class="absolute inset-y-0 right-3 flex items-center cursor-pointer text-gray-500"
                          style="top:35px;">
                    </span>
                </div>

                <!-- Company Selection -->
                @* <div>
                    <label for="Company" class="block text-sm font-medium text-gray-700 mb-1">Company</label>
                    <select id="Company" name="Company" 
                            class="w-full border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-blue-400 transition duration-200"
                            style="height:28px; font-size:10px; padding:2px 6px;">
                        <option value="">-- Select Company --</option>
                        @if (ViewBag.companyList != null)
                        {
                            @foreach (var data in ViewBag.companyList)
                            {
                                <option value="@data.Value" title="@data.Value">@data.Text</option>
                            }
                        }
                    </select>
                </div> *@

                <div class="flex items-center">
                    <input type="checkbox" id="RememberMe" name="RememberMe">
                    <label for="RememberMe" class="ml-2 text-sm">Remember me</label>
                </div>

                <!-- Button -->
                @if (ViewBag.LoginError != null)
                {
                    <div class="text-red-600 text-sm font-semibold mb-4 text-center">
                        @ViewBag.LoginError
                    </div>
                }

                <div>
                    @*                     <button type="submit" accesskey="l"
                            class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-lg font-semibold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-200 transform hover:scale-105">
 *@ 
                    <button type="submit" accesskey="l"
                            class="login-btn w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-lg font-semibold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-200 transform hover:scale-105">
                        Login
