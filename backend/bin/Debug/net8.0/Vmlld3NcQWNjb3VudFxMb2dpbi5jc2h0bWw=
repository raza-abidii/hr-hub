    <!-- Create Company Modal -->
    <div id="createCompanyModal"
         class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white rounded-xl shadow-lg w-96 p-6 relative">
            <!-- Close Button -->
            <button onclick="closeCreateCompany()"
                    class="absolute top-3 right-3 text-gray-500 hover:text-gray-700">
                ✖
            </button>

            <h2 class="text-xl font-bold text-gray-800 mb-4 text-center">Create Company</h2>

            <form id="createCompanyForm" class="space-y-4">
                <!-- Company Name -->
                <div>
                    <label for="CompanyName" class="block text-sm font-medium text-gray-700 mb-1">Company Name</label>
                    <input type="text" id="CompanyName" name="CompanyName" required
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>

                <!-- Database Name -->
                <div>
                    <label for="DatabaseName" class="block text-sm font-medium text-gray-700 mb-1">Database Name</label>
                    <input type="text" id="DatabaseName" name="DatabaseName" required
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>

                <!-- Accounting Date -->
                <div>
                    <label for="AccountingDate" class="block text-sm font-medium text-gray-700 mb-1">Accounting Date</label>
                    <input type="date" id="AccountingDate" name="AccountingDate" required
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
