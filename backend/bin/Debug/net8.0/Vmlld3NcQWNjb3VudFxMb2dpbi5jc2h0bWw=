<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HRM Software Login</title>
    <!-- Tailwind CSS CDN -->

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f0f2f5; /* Light gray background */
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }
        /* Custom styles for a more polished look */
        .card-shadow {
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        }

        .input-focus:focus {
            border-color: #6366f1; /* Indigo-500 */
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.3); /* Indigo-300 with transparency */
        }



        .animate-fadeInSlideUp {
            animation: fadeInSlideUp 0.8s ease-out forwards;
        }


        .login-btn {
            background: linear-gradient(45deg, #6a11cb, #2575fc);
            border: none;
            color: #fff;
            padding: 12px 28px;
            font-size: 1.1rem;
            border-radius: 30px;
            cursor: pointer;
            transition: 0.3s;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

            .login-btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
            }
    </style>

    <style>
        body {
            position: relative;
            min-height: 100vh;
            margin: 0;
        }

            /* Background that auto-resizes */
            body::before {
                content: "";
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-image: url('@imagePath4');
                background-size: cover; /* 🔥 Auto resize based on resolution */
                background-repeat: no-repeat;
                background-position: center center;
                background-attachment: fixed; /* Optional: smooth scrolling effect */

                opacity: 0.25; /* Low opacity */
                z-index: -1; /* Keep behind all content */
            }
    </style>

    @* <link rel="stylesheet" href="~/css/Style.css"> *@
</head>

<body class="h-screen bg-gray-100 flex items-center justify-center">
    <div id="loader-overlay">
