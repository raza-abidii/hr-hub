    </div>

    <div class="flex flex-col md:flex-row bg-white rounded-2xl card-shadow overflow-hidden w-full max-w-4xl h-auto md:h-[80%] m-4">

        <!-- Left Section -->
        @* <div class="md:w-1/2 p-8 flex flex-col justify-center items-center bg-gradient-to-br from-indigo-500 to-purple-600 text-white text-center relative"> *@
        <div class="md:w-3/5 p-8 flex flex-col justify-center items-center bg-gradient-to-br from-indigo-500 to-purple-600 text-white text-center relative">
            <div id="slide-background" class="absolute inset-0 opacity-30 bg-cover bg-center z-0"></div>

            <!-- Icon/Logo Placeholder -->
            <svg id="slide-icon" class="w-24 h-24 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path id="slide-icon-path" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
