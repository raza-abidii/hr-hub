<script>
    // call this if login fails
    function showError(message) {
        let alertBox = document.createElement("div");
        alertBox.className = "alert alert-danger alert-dismissible fade show mt-3";
        alertBox.role = "alert";
        alertBox.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        `;
        document.querySelector(".card").prepend(alertBox);
    }


</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.getElementById("UserName").focus();
    });
</script>

<script>
    // Load values when page loads
    window.onload = function () {
        const remembered = localStorage.getItem("RememberMe");
        if (remembered === "true") {
            document.getElementById("UserId").value = localStorage.getItem("UserId") || "";
            document.getElementById("Password").value = localStorage.getItem("Password") || "";
            document.getElementById("RememberMe").checked = true;
        }
    };

    // Save on submit
    function saveRememberMe() {
        const rememberMe = document.getElementById("RememberMe").checked;
        const userId = document.getElementById("UserId").value;
        // const password = document.getElementById("Password").value;

        if (rememberMe) {
            localStorage.setItem("RememberMe", "true");
            localStorage.setItem("UserId", userId);
            // localStorage.setItem("Password", password); // ⚠️ not secure
        } else {
            localStorage.removeItem("RememberMe");
            localStorage.removeItem("UserId");
            // localStorage.removeItem("Password");
        }

        return true; // allow form to submit
    }
</script>

<script>
    const passwordInput = document.getElementById("password");
    const togglePassword = document.getElementById("togglePassword");

    togglePassword.addEventListener("click", function () {
        const type = passwordInput.getAttribute("type") === "password" ? "text" : "password";
        passwordInput.setAttribute("type", type);
        // Toggle icon (👁️ for show, 🙈 for hide)
        this.textContent = type === "password" ? "👁️" : "🙈";
    });
</script>

<script>
    function openCreateCompany() {
        debugger;
        // Clear existing values before showing modal
        document.getElementById("CompanyName").value = "";
        document.getElementById("DatabaseName").value = "";
        document.getElementById("AccountingDate").value = "";

        // Hide any validation message (if you added one)
        const dbNameError = document.getElementById("dbNameError");
        if (dbNameError) {
            dbNameError.classList.add("hidden");
        }
        document.getElementById("createCompanyModal").classList.remove("hidden");
    }

    function closeCreateCompany() {
        document.getElementById("createCompanyModal").classList.add("hidden");
    }

    function validateDatabaseName(dbName) {
         const validPattern = /^[A-Za-z0-9_]+$/; // only letters, numbers, and underscores
         if (!validPattern.test(dbName)) {
             alert("❌ Database Name can only contain letters, numbers, and underscores (no spaces or special characters).");
             return false;
         }
         return true;
     }

    // Example form submission handler (replace with actual POST or AJAX)
    document.getElementById("createCompanyForm").addEventListener("submit", function (e) {
        e.preventDefault();
        debugger;
        const companyName = document.getElementById("CompanyName").value.trim();
        const databaseName = document.getElementById("DatabaseName").value.trim();
        const accountingDate = document.getElementById("AccountingDate").value;

        if (!companyName || !databaseName || !accountingDate) {
            alert("Please fill all fields.");
            return;
        }
        if (!validateDatabaseName(databaseName)) {
            return;
        }
        var companyDetail = {
            CompanyName: companyName,
            DatabaseName: databaseName,
            AccountingDate: accountingDate
        };

         if (window.$ && $('#loader-overlay').length) {
                $('#loader-overlay').show();
            }

        // Example: You can replace this with AJAX or form submission logic
        //call company Controller=> CreateCompany Action
        $.ajax({
            type: "POST",
            url: '@Url.Action("createCompany", "Company")',
            data: companyDetail,

            success: function (response) {
                if (response.status) {
                    alert(response.message);
                    // Close modal and reset form
                    closeCreateCompany();

                    document.getElementById("createCompanyForm").reset();
                    if (window.$ && $('#loader-overlay').length) {
                        $('#loader-overlay').hide();
                    }
                    // 🔁 Refresh the page after short delay (so user sees alert first)
                    setTimeout(function () {
                        location.reload();
                    }, 1000);
                } else {
                    alert(response.message);
                     if (window.$ && $('#loader-overlay').length) {
                        $('#loader-overlay').hide();
                    }
                }
            },
            error: function (xhr, status, error) {
                console.error("Error occurred:", error);
                 if (window.$ && $('#loader-overlay').length) {
                        $('#loader-overlay').hide();
                    }
                alert("An error occurred while saving company details.");

            }

        });

    });
</script>