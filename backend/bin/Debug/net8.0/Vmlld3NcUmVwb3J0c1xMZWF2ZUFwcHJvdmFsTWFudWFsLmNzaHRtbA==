@model List< EMSSolution.Models.LeaveApprovalModel>

@{
    ViewBag.Title = "Leave Approval";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/Style.css">
    <style>
        .flex {
            display: flex;
            gap: 16px;
        }
        input:invalid {
            border: 2px solid red;
        }

    </style>

  
</head>
<body>
    <div class="container">
        <h4 class="text-center d-flex justify-content-center align-items-center gap-2">
            Leave Approval Form
            <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="#28a745"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <!-- Calendar outline -->
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
                <!-- Checkmark -->
                <polyline points="9 16 11.5 18.5 15 14" stroke="#28a745" stroke-width="2" />
            </svg>
        </h4>
        <div class="form-group">
            <label>Select Employee:</label>
            <select id="employee" name="employee" class="form-control">
                <option value="0">-- Select --</option>

                @foreach (var emp in ViewBag.Employees)
                {
                    <option value="@emp.iMasterid">@emp.sEmployeeName</option>
                }
            </select>
        </div>
        <button id="btnDisplay" class="btn btn-primary mt-2">Display</button>

        <div class="table-responsive">
            <table class="table table-striped table-hover" id="leaveTable">
                <thead>
                    <tr>
                        <th>SNo</th>
                        <th>Employee Name</th>
                        <th>Employee Code</th>
                        <th>Remarks</th>
                        <th>Date</th>
                        <th>Reporting Manager</th>
                        <th hidden>LeaveId</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>


    <div class="modal fade" id="remarksModal" tabindex="-1" role="dialog" aria-labelledby="remarksModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="remarksModalLabel">Enter Remarks</h5>
                   
                </div>
                <div class="modal-body">
                    <input type="hidden" id="modalLeaveId" />
                    <input type="hidden" id="modalActionType" />
                    <div class="form-group">
                        <label for="modalRemarks">Remarks</label>
                        <textarea class="form-control" id="modalRemarks" rows="3" placeholder="Enter your remarks"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" id="submitRemarks" class="btn btn-primary">Submit</button>
                    <button type="button" class="btn btn-secondary" onclick="$('#remarksModal').modal('hide')">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

<script>
    $('#remarksModal').on('hide.bs.modal', function (e) {
        //e.preventDefault();
    });
</script>

<script>
    $(document).ready(function() {
        $('#employee').select2({
            placeholder: "Select employee",
            allowClear: true
        });
        focusonselectcontrol("#employee");
        $("#employee").focus();
    });

    $('#btnDisplay').click(function () {
        debugger;
        var empId=$('#employee').val()||0;

         $.ajax({
            url: '@Url.Action("GetLeaveApplication", "LeaveApprovalManual")',
            type: 'post',
            data: {
                empId: empId
            },
            success: function (response) {
                debugger;
                if (response.success) {
                    var tbody = $('#leaveTable tbody');
                    tbody.empty(); // Clear previous data
                    $.each(response.data, function (index, item) {
                        var row = `<tr>
                            <td>${index + 1}</td>
                            <td>${item.employeeName}</td>
                            <td>${item.employeeCode}</td>
                            <td>${item.remarks}</td>
                            <td>${item.dDate}</td>
                            <td>${item.reportingTo}</td>
                                
                            <td style="display:none" >${item.leaveId}</td>
                            <td style="display: flex; gap: 5px; justify-content: center; align-items: center;">
                                <button class="btn  btnApprove" data-id="${item.leaveId}">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="green" viewBox="0 0 24 24">
                                        <path d="M20.285 6.709l-11.285 11.291-5.285-5.291 1.415-1.418 3.87 3.877 9.87-9.877z"/>
                                    </svg>
                                </button>
                                <button class="btn  btnReject" data-id="${item.leaveId}">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="red" viewBox="0 0 24 24">
                                        <path d="M18.364 5.636l-1.414-1.414L12 9.172 7.05 4.222 5.636 5.636 10.586 10.586 5.636 15.536l1.414 1.414L12 12.828l4.95 4.95 1.414-1.414-4.95-4.95z"/>
                                    </svg>
                                </button>
                            </td>
                        </tr>`;
                        tbody.append(row);
                    });
                } else {
                    alert(response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("Error fetching data:", error);
            }
        });
    });
</script>

<script>
    let selectedAction = '';
    let selectedLeaveId = 0;

    $('body').on('click', '.btnApprove, .btnReject', function () {
        selectedLeaveId = $(this).data('id');
        selectedAction = $(this).hasClass('btnApprove') ? 'Approve' : 'Reject';

        $('#modalLeaveId').val(selectedLeaveId);
        $('#modalActionType').val(selectedAction);
        $('#modalRemarks').val('');
        $('#remarksModal').modal('show');
    });

    $('#submitRemarks').click(function () {
        var id = $('#modalLeaveId').val();
        var action = $('#modalActionType').val();
        var remarks = $('#modalRemarks').val();

        if (!remarks.trim()) {
            alert("Remarks are required.");
            return;
        }

        $.post(`@Url.Action("HandleLeaveAction", "LeaveApprovalManual")`, {
            id: id,
            actionType: action,
            remarks: remarks
        }, function (res) {
            if (res.success) {
                alert(`Leave ${action}d successfully.`);
                $('#remarksModal').modal('hide');
                $('#btnDisplay').click(); // Reload table
            } else {
                alert(res.message);
            }
        });
    });
</script>